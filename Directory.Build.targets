<Project>
  <!-- The Po build stamp a project opts into with StampBuildVersion (the client shows it bottom-right as vYYMMDD, and the
       server reports the same value from the client assembly): the UTC date of the commit being built, or today's UTC
       date outside a Git checkout. TZ=UTC with format-local turns the commit's own time zone into UTC on every OS.
       Exec runs through cmd on Windows, where a literal % must be doubled. -->
  <PropertyGroup>
    <_GitDateFormat Condition="$([MSBuild]::IsOSPlatform('Windows'))">%25%25y%25%25m%25%25d</_GitDateFormat>
    <_GitDateFormat Condition="!$([MSBuild]::IsOSPlatform('Windows'))">%25y%25m%25d</_GitDateFormat>
  </PropertyGroup>

  <Target Name="StampBuildVersion" BeforeTargets="GetAssemblyAttributes" Condition="'$(StampBuildVersion)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="git log -1 --format=%25%25cd --date=format-local:$(_GitDateFormat)" Condition="$([MSBuild]::IsOSPlatform('Windows'))"
          EnvironmentVariables="TZ=UTC" ConsoleToMsBuild="true" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDate" />
    </Exec>
    <Exec Command="git log -1 --format=%25cd --date=format-local:$(_GitDateFormat)" Condition="!$([MSBuild]::IsOSPlatform('Windows'))"
          EnvironmentVariables="TZ=UTC" ConsoleToMsBuild="true" IgnoreExitCode="true" ContinueOnError="true"
          StandardOutputImportance="low" StandardErrorImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitDate" />
    </Exec>
    <PropertyGroup>
      <BuildStamp Condition="'$(BuildStamp)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitDate)', '^\d{6}$'))">$(_GitDate)</BuildStamp>
      <BuildStamp Condition="'$(BuildStamp)' == ''">$([System.DateTime]::UtcNow.ToString('yyMMdd'))</BuildStamp>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildStamp</_Parameter1>
        <_Parameter2>$(BuildStamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
