<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Runs in the browser too: trim- and AOT-unsafe code breaks the build (trim, AOT and
         single-file analyzers), and the assembly is marked safe to trim. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- Form rules live here so the client form and the API endpoint check the same things. -->
    <PackageReference Include="FluentValidation" />
  </ItemGroup>
</Project>
