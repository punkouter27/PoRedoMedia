@using Microsoft.AspNetCore.Components.Web
@using PoRedoMedia.Client
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a23" media="(prefers-color-scheme: dark)" />
    @* Light and dark follow the device (prefers-color-scheme), with no switch: the browser applies whichever of
       Radzen's two themes matches. po-tokens.css comes after them, so its Radzen bridge wins. *@
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-base.css" media="(prefers-color-scheme: light)" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-dark-base.css" media="(prefers-color-scheme: dark)" />
    <link rel="stylesheet" href="css/po-tokens.css" />
    <link rel="stylesheet" href="css/po-motion.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/movie.css" />
    @* The client's component styles, linked directly: the host's PoRedoMedia.Api.styles.css only @imports this file,
       and an @import after the app's CSS loads late and in a second round trip. *@
    <link rel="stylesheet" href="PoRedoMedia.Client.bundle.scp.css" />
    <HeadOutlet @rendermode="NoPrerender" />
</head>
<body>
    <canvas id="po-backdrop" aria-hidden="true"></canvas>
    <Routes @rendermode="NoPrerender" />
    <script src="js/po-devwindow.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="js/browser-actions.js"></script>
    @* The effects layer first: everything after it asks it whether effects run. *@
    <script src="js/fx/fx-core.js"></script>
    <script src="js/sfx.js"></script>
    <script src="js/backdrop.js"></script>
    <script src="js/fx/fluid.js"></script>
    <script src="js/fx/particles.js"></script>
    <script src="js/fx/dissolve.js"></script>
    <script src="js/fx/morph.js"></script>
    <script src="js/fx/reactor.js"></script>
    <script src="js/fx/confetti.js"></script>
    <script src="js/fx/concert.js"></script>
    <script src="js/fx/waveform.js"></script>
    <script src="js/fx/tilt.js"></script>
    <script src="js/roast-stage.js"></script>
    <script src="js/movie.js"></script>
    <script src="js/local-ai/local-ai-interop.js"></script>
    <script src="js/local-ai/device-tasks.js"></script>
    <script>
        if ('serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(function () { });
    </script>
</body>
</html>

@code {
    // The WASM client owns the only DI container for UI services, so a server prerender pass
    // could not resolve them.
    private static readonly IComponentRenderMode NoPrerender = new InteractiveWebAssemblyRenderMode(prerender: false);
}