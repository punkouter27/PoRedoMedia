@page "/"
@using PoRedoMedia.Client.LocalAi
@implements IDisposable
@inject MediaApi Media
@inject RunApi Runs
@inject RunTracker Tracker
@inject AppConfigService Config
@inject SessionCostService Cost
@inject LocalAiService LocalAi
@inject HttpClient Http
@inject UiStore Store
@inject AppSettings Settings
@inject Shortcuts Keys
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>PoRedoMedia</PageTitle>

<PageBoundary>
<div class="create-page">
    @* Three steps, one screen each: pick the media, tick the functions, watch the run. *@
    <div class="create-head">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Create</RadzenText>
        <CreateSteps Current="Step" CanFunctions="@(_source is not null)" CanRun="@(_run is not null)" Go="GoAsync" />
    </div>

    @if (_opening)
    {
        <div class="po-skeleton create-skeleton" role="status" aria-label="Loading"></div>
    }
    else if (Step == 1)
    {
        @* Home: the drop zone and recent media. Runs left show beside Run; past runs are in the header's Runs. *@
        <MediaPicker ValueChanged="PickAsync" TakeShared="@(Shared is not null)" />
    }
    else
    {
        <div class="create-split">
            @if (_source is not null)
            {
                <RadzenCard class="create-preview po-pop po-glass">
                    <MediaView Media="_source" />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@_source.Title · @_source.Kind.ToString().ToLowerInvariant()</RadzenText>
                    <RadzenButton Text="Change media" Variant="Variant.Outlined" Disabled="@(_starting || _run is { Finished: false })" Click="StartOver" />
                </RadzenCard>
            }
            <RadzenCard class="create-functions po-glass">
                @if (_run is not null)
                {
                    <RunView Run="_run" Source="_source" Quota="_quota" Problem="@_problem" Starting="_starting" Cancelling="@(_cancelling == _run.Run.Id)"
                             Cancel="CancelRunAsync" Retry="RunAsync" BackToFunctions="BackToFunctions" StartOver="StartOver" />
                }
                else if (_source is not null)
                {
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-mt-0 rz-mb-2">What should happen to this @_source.Kind.ToString().ToLowerInvariant()?</RadzenText>
                    @if (Settings[AppSettings.Recipes])
                    {
                        <RecipeBar Kind="_source.Kind" Functions="_functions" Options="_options" Applied="ApplyRecipe" />
                    }

                    @* What to do on one side, how to do it on the other, once the screen is wide enough. *@
                    <div class="create-compose">
                        <div class="create-pick">
                            <FunctionPicker Kind="_source.Kind" Value="_functions" ValueChanged="OnFunctionsChanged" Available="_available" />
                        </div>
                        <div class="create-options">
                            <FunctionOptions Functions="_functions" Options="_options" RoastVoices="_roastVoices" Duration="_source.DurationSeconds" Changed="StateHasChanged" />
                            @if (_functions.Count == 0)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 create-hint">Tick one or more functions. Their settings appear here.</RadzenText>
                            }
                        </div>
                    </div>

                    @if (_localStatus is not null)
                    {
                        <RadzenText class="rz-mt-2 rz-mb-0" aria-live="polite">@_localStatus</RadzenText>
                    }
                    @if (_problem is not null)
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-mt-2 rz-mb-0">@_problem</RadzenAlert>
                    }

                    <div class="create-bar">
                        <div class="create-summary">
                            @if (_functions.Count == 0)
                            {
                                <RadzenText class="rz-m-0">Tick at least one function.</RadzenText>
                            }
                            else
                            {
                                <RadzenText class="rz-m-0"><strong>@_source.Title</strong> → @string.Join(", then ", _functions.Select(FunctionStack.Label))</RadzenText>
                                @if (DeviceMayLook)
                                {
                                    @* Local first: with the model already in this browser, it describes the picture. *@
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                                        @(_deviceReady ? "The picture is described on this device, free; the server steps in if that fails." : "The picture is described by the server. Get the on-device model ready in Settings to do it here.")
                                    </RadzenText>
                                }
                                @if (Settings[AppSettings.CostEstimates])
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">
                                        Estimated cost: $@(AiCatalog.EstimateCost(_functions, EstimateOptions, _pricing).ToString("0.00"))
                                    </RadzenText>
                                }
                            }
                            @QuotaLine
                        </div>
                        @if (_quota is { Unlimited: false } quota)
                        {
                            <QuotaDial Quota="quota" />
                        }
                        <RadzenButton Text="Run" Icon="play_arrow" IsBusy="_starting" Click="RunAsync" Disabled="@(!Runnable)" title="Run (R)" />
                    </div>
                }
            </RadzenCard>
        </div>
    }
</div>
</PageBoundary>

@code {
    /// <summary>Options worth carrying from one run to the next. Text typed for one picture is not.</summary>
    private static readonly string[] Remembered =
    [
        RunOptions.VideoAspect, RunOptions.VideoPersona, RunOptions.VideoRoastVoice,
    ];

    /// <summary>A gallery item to start from, set by "Use as source".</summary>
    [SupplyParameterFromQuery] public Guid? Source { get; set; }

    /// <summary>A run to show, set when one starts and by the header's run tray.</summary>
    [SupplyParameterFromQuery] public Guid? Run { get; set; }

    /// <summary>Present when another app shared a file to this one.</summary>
    [SupplyParameterFromQuery] public string? Shared { get; set; }

    private MediaDto? _source;
    private IReadOnlyList<MediaFunction> _functions = [];
    private Dictionary<string, string> _options = [];
    private IReadOnlyCollection<MediaFunction> _available = [];
    private IReadOnlyList<string> _roastVoices = [];
    private AiPricingDto _pricing = new(0, 0, 0, 0, 0);
    private Dictionary<string, string> _lastOptions = [];
    private string? _localStatus;
    private QuotaStatusDto? _quota;
    private TrackedRun? _run;
    private string? _problem;
    private bool _starting;
    private bool _opening;
    private bool _deviceReady;
    private Guid? _openedSource;
    private Guid? _cancelling;
    private IDisposable? _keys;

    private int Step => _run is not null ? 3 : _source is not null ? 2 : 1;

    private bool Runnable => _source is not null && _run is null && _functions.Count > 0 && !_starting && _quota is not { Unlimited: false, Remaining: 0 };

    /// <summary>On-device AI is on and the ticked functions have the picture described.</summary>
    private bool DeviceMayLook => Settings[AppSettings.OnDeviceAi] && AiCatalog.LooksAtPicture(_functions, _options);

    /// <summary>The options as the run will likely go, for the estimate: free vision when the device will look.</summary>
    private Dictionary<string, string> EstimateOptions => DeviceMayLook && _deviceReady
        ? new(_options) { [RunOptions.VisionModel] = AiCatalog.BrowserVision }
        : _options;

    private RenderFragment? QuotaLine => _quota is { Unlimited: false }
        ? @<RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 create-quota">@_quota.Remaining of @_quota.Limit runs left today. A run costs one.</RadzenText>
        : null;

    protected override async Task OnInitializedAsync()
    {
        Tracker.Changed += OnRunChanged;
        Tracker.Finished += OnRunFinished;
        Settings.Changed += OnRunChanged;
        _keys = Keys.Register(OnKeyAsync);

        var config = await Config.GetAsync();
        _available = config?.AvailableFunctions ?? [];
        _roastVoices = config?.RoastVoices ?? [];
        _pricing = config?.Pricing ?? _pricing;
        _quota = await Runs.GetQuotaAsync();
        _lastOptions = await Store.ReadAsync(UiStore.LastOptions, WireJson.Default.DictionaryStringString) ?? [];
        if (Settings[AppSettings.OnDeviceAi])
            _deviceReady = await LocalAi.IsVisionReadyAsync();
    }

    // The address decides what the page shows, so back, forward and refresh all land where they were.
    protected override async Task OnParametersSetAsync()
    {
        if (Run is { } runId)
        {
            if (_run?.Run.Id == runId)
                return;

            _opening = true;
            if (await Tracker.FindAsync(runId) is { } run)
            {
                _source = await Media.GetAsync(run.Run.SourceId);
                (_run, _functions, _options, _problem) = (run, run.Run.Functions, new(run.Run.Options ?? []), null);
            }

            _opening = false;
        }
        else if (Source is { } id)
        {
            if (_openedSource == id)
                return;

            (_opening, _openedSource) = (true, id);
            // Audio has no functions, so it is never a source, whatever the address says.
            if (await Media.GetAsync(id) is { Kind: not MediaKind.Audio } media)
                await PickAsync(media);
            _opening = false;
        }
        else if (_run is not null || _openedSource is not null)
        {
            // The address went back to plain "/": the page goes back to choosing media.
            (_source, _functions, _options, _run, _problem, _openedSource) = (null, [], [], null, null, null);
        }
    }

    private Task PickAsync(MediaDto media)
    {
        (_source, _functions, _run, _problem) = (media, [], null, null);
        _options = _lastOptions.Where(o => Remembered.Contains(o.Key)).ToDictionary(o => o.Key, o => o.Value);
        return Task.CompletedTask;
    }

    private Task GoAsync(int step)
    {
        switch (step)
        {
            case 1:
                StartOver();
                break;
            case 2 when _source is not null && _run is not null:
                BackToFunctions();
                break;
        }

        return Task.CompletedTask;
    }

    private async Task CancelRunAsync()
    {
        _cancelling = _run!.Run.Id;
        _problem = await Runs.CancelAsync(_run.Run.Id);
        if (_problem is not null)
            _cancelling = null;
    }

    private void OnFunctionsChanged(IReadOnlyList<MediaFunction> functions) => (_functions, _problem) = (functions, null);

    private void ApplyRecipe(RunRequest recipe)
    {
        _functions = FunctionStack.InRunOrder(recipe.Functions.Where(_available.Contains));
        _options = new(recipe.Options ?? []);
        _problem = null;
    }

    private async Task RunAsync()
    {
        if (_starting)
            return;

        _problem = FunctionOptions.Missing(_functions, _options);
        if (_problem is not null)
            return;

        // What looks at the picture is decided afresh for every run: a description left over from
        // an earlier one must not ride along, or the server would use it and never look.
        _options.Remove(RunOptions.VisionDescription);
        _options.Remove(RunOptions.VisionModel);

        _starting = true;
        try
        {
            // Asked here, on the click that starts something worth being told about.
            await JS.InvokeVoidAsync("poMedia.askNotify");
            if (DeviceMayLook && await LocalAi.IsVisionReadyAsync())
                await DescribeOnDeviceAsync();

            var estimate = AiCatalog.EstimateCost(_functions, _options, _pricing);
            // Options of functions that were ticked and then unticked stay in the form; they are not sent.
            var sent = _options
                .Where(o => o.Key.StartsWith("Vision.", StringComparison.Ordinal) || o.Key.StartsWith("Video.", StringComparison.Ordinal)
                    || _functions.Any(f => o.Key.StartsWith(f + ".", StringComparison.Ordinal)))
                .ToDictionary(o => o.Key, o => o.Value);
            var (started, problem) = await Runs.StartAsync(new RunRequest(_source!.Id, [.. _functions], sent));
            _problem = problem;
            if (started is null)
                return;

            Cost.Add(estimate);
            await JS.InvokeVoidAsync("poSfx.play", "start");
            foreach (var option in _options.Where(o => Remembered.Contains(o.Key)))
                _lastOptions[option.Key] = option.Value;
            await Store.WriteAsync(UiStore.LastOptions, _lastOptions, WireJson.Default.DictionaryStringString);

            _run = Tracker.Track(started);
            // The run is in the address from here on: a refresh, or the tray, comes back to it.
            Navigation.NavigateTo($"?run={started.Id}", replace: true);
        }
        finally
        {
            _starting = false;
        }
    }

    /// <summary>
    /// Local first: the on-device model describes the picked picture and the run carries what it
    /// wrote, so the server never looks (and nothing is charged for looking). When the device
    /// fails, the run goes ahead with the server looking instead, and says so.
    /// </summary>
    private async Task DescribeOnDeviceAsync()
    {
        try
        {
            _localStatus = "Looking at the picture on your device…";
            StateHasChanged();
            var image = await Http.GetByteArrayAsync(_source!.Url);
            var outcome = await LocalAi.DescribeImageAsync(image, prompt: null, new Progress<LocalInferenceStatus>(status =>
            {
                _localStatus = status.LoadPercent is { } percent ? $"Getting the on-device model ready: {percent}%" : "Looking at the picture on your device…";
                InvokeAsync(StateHasChanged);
            }));
            _options[RunOptions.VisionModel] = AiCatalog.BrowserVision;
            _options[RunOptions.VisionDescription] = outcome.Text;
        }
        catch (Exception ex) when (ex is LocalInferenceException or HttpRequestException)
        {
            var why = ex is LocalInferenceException local ? LocalAiErrorClassifier.Describe(local.Failure) : "The picture could not be fetched for it.";
            Notifications.Notify(NotificationSeverity.Info, "The server looks at this one", $"The on-device model did not finish. {why}", 8000);
        }
        finally
        {
            _localStatus = null;
        }
    }

    /// <summary>Create's keys, from the app's one listener: U chooses a file, R runs. False for a key it leaves to the app.</summary>
    private async Task<bool> OnKeyAsync(string key)
    {
        switch (key)
        {
            case "u" or "U" when Step == 1 && !_opening:
                return await JS.InvokeAsync<bool>("poMedia.chooseFile");
            case "r" or "R" when Runnable:
                await RunAsync();
                StateHasChanged();
                return true;
            case "r" or "R":
                // Not runnable here: nothing to do, and nothing for the app to do either.
                return true;
            default:
                return false;
        }
    }

    private void OnRunChanged() => InvokeAsync(StateHasChanged);

    private void OnRunFinished(TrackedRun run) => InvokeAsync(async () =>
    {
        _quota = await Runs.GetQuotaAsync();
        StateHasChanged();
    });

    /// <summary>The same source with its ticks and options as they were, ready to change and run again.</summary>
    private void BackToFunctions()
    {
        (_run, _problem, _openedSource) = (null, null, _source!.Id);
        Navigation.NavigateTo($"?source={_source.Id}", replace: true);
    }

    private void StartOver()
    {
        (_source, _functions, _options, _run, _problem, _openedSource) = (null, [], [], null, null, null);
        Navigation.NavigateTo("", replace: true);
    }

    public void Dispose()
    {
        Tracker.Changed -= OnRunChanged;
        Tracker.Finished -= OnRunFinished;
        Settings.Changed -= OnRunChanged;
        _keys?.Dispose();
    }
}
