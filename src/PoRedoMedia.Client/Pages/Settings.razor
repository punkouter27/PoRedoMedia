@page "/settings"
@attribute [AllowAnonymous]
@* Who is signed in, how the app looks and sounds in this browser, the advanced switches, and
   sign out. Open before sign-in too, where only the look and sound show. *@
@implements IDisposable
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AppSettings Switches
@inject PreferenceSync Preferences
@inject NotificationService Notifications
@inject LocalAiService LocalAi
@using PoRedoMedia.Client.LocalAi

<PageTitle>Settings · PoRedoMedia</PageTitle>

<PageBoundary>
<div class="settings-page">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">Settings</RadzenText>

    <AuthorizeView>
        <RadzenCard class="settings-card">
            <div class="settings-who">
                <span class="settings-avatar" aria-hidden="true">@Initial(context.User.Identity?.Name ?? "")</span>
                <span class="settings-name">@context.User.Identity?.Name</span>
                <RadzenButton Text="Sign out" Icon="logout" Variant="Variant.Outlined" IsBusy="_leaving" Click="SignOutAsync" class="settings-signout" />
            </div>
        </RadzenCard>
    </AuthorizeView>

    <RadzenCard class="settings-card">
        <section aria-labelledby="settings-look">
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0 rz-mb-1" id="settings-look">Look and sound</RadzenText>
            <div class="settings-row">
                <RadzenSwitch Name="settings-dark" Value="_dark" Change="SetDarkAsync" />
                <RadzenLabel Component="settings-dark" Text="Dark theme" />
            </div>
            <div class="settings-row">
                <RadzenSwitch Name="settings-sounds" Value="_sounds" Change="SetSoundsAsync" />
                <RadzenLabel Component="settings-sounds" Text="Interface sounds" />
            </div>
            <div class="settings-row">
                <RadzenLabel Component="settings-volume" Text="Volume" />
                <RadzenSlider Name="settings-volume" TValue="int" Min="0" Max="100" Step="5" Value="_volume" Disabled="@(!_sounds)"
                              Change="SetVolumeAsync" aria-label="Volume" class="po-grow" />
            </div>
            <div class="settings-row">
                <RadzenLabel Component="settings-sound-theme" Text="Sound theme" />
                @* The sets of interface sounds in js/sfx.js; Studio is the original. *@
                <RadzenSelectBar Name="settings-sound-theme" TValue="string" Value="_theme" Disabled="@(!_sounds)" Change="SetThemeAsync"
                                 Size="ButtonSize.Small" aria-label="Sound theme">
                    <Items>
                        <RadzenSelectBarItem Text="Studio" Value="@("studio")" />
                        <RadzenSelectBarItem Text="Arcade" Value="@("arcade")" />
                        <RadzenSelectBarItem Text="Soft" Value="@("soft")" />
                    </Items>
                </RadzenSelectBar>
            </div>
        </section>
    </RadzenCard>

    <AuthorizeView>
        <RadzenCard class="settings-card">
            <section aria-labelledby="settings-advanced">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0" id="settings-advanced">Advanced</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0 rz-mb-1">All off to start with. Each one adds to the app; none is needed for it to work.</RadzenText>
                @foreach (var setting in AppSettings.Advanced)
                {
                    var name = $"settings-{setting.Key.Replace('.', '-')}";
                    <div class="settings-row settings-advanced-row">
                        <RadzenSwitch Name="@name" Value="@Switches[setting]" Change="@(on => SetAsync(setting, on))" />
                        <span class="settings-text">
                            <RadzenLabel Component="@name" Text="@setting.Label" />
                            <span class="settings-hint">@setting.Hint</span>
                        </span>
                    </div>
                    @if (setting == AppSettings.OnDeviceAi && Switches[setting])
                    {
                        @* Local first: once the model is in this browser, Create describes pictures with it on its own. *@
                        <div class="settings-row settings-device">
                            @if (_deviceReady)
                            {
                                <RadzenIcon Icon="check_circle" aria-hidden="true" class="settings-ready" />
                                <span class="settings-hint">The on-device model is ready. Pictures are described here first, and by the server if that fails.</span>
                            }
                            else
                            {
                                <RadzenButton Text="Get the model ready" Icon="download" Variant="Variant.Outlined" Size="ButtonSize.Small" IsBusy="@(_warming is not null)" Click="WarmUpAsync" />
                                <span class="settings-hint" aria-live="polite">@(_warming ?? "About 230 MB, once. Until then the server describes pictures.")</span>
                            }
                        </div>
                    }
                }
            </section>
        </RadzenCard>
    </AuthorizeView>
</div>
</PageBoundary>

@code {
    private bool _dark;
    private bool _sounds;
    private int _volume = 50;
    private string _theme = "studio";
    private bool _leaving;
    private bool _deviceReady;
    private string? _warming;

    public static string Initial(string name) => name.Length == 0 ? "?" : char.ToUpperInvariant(name[0]).ToString();

    // The account's settings can arrive after the page is drawn (Services/PreferenceSync).
    protected override void OnInitialized() => Switches.Changed += OnSwitchesChanged;

    private void OnSwitchesChanged() => InvokeAsync(ReadAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ReadAsync();
    }

    private async Task ReadAsync()
    {
        _dark = await JS.InvokeAsync<string>("poMedia.theme") == "dark";
        _sounds = !await JS.InvokeAsync<bool>("poSfx.muted");
        _volume = (int)Math.Round(await JS.InvokeAsync<double>("poSfx.volume") * 100);
        _theme = await JS.InvokeAsync<string?>("poSfx.theme") ?? "studio";
        if (Switches[AppSettings.OnDeviceAi])
            _deviceReady = await LocalAi.IsVisionReadyAsync();
        StateHasChanged();
    }

    private async Task SetDarkAsync(bool on)
    {
        _dark = on;
        await JS.InvokeVoidAsync("poMedia.setTheme", on ? "dark" : "light");
    }

    private async Task SetSoundsAsync(bool on)
    {
        _sounds = on;
        await JS.InvokeVoidAsync("poSfx.setMuted", !on);
        Preferences.Schedule();
        await JS.InvokeVoidAsync("poSfx.play", "tick");
    }

    private async Task SetVolumeAsync(int value)
    {
        _volume = value;
        await JS.InvokeVoidAsync("poSfx.setVolume", value / 100.0);
        Preferences.Schedule();
        await JS.InvokeVoidAsync("poSfx.play", "tick");
    }

    // A theme is heard straight away, by the sound it plays most: a run finishing.
    private async Task SetThemeAsync(string theme)
    {
        _theme = theme;
        await JS.InvokeVoidAsync("poSfx.setTheme", theme);
        Preferences.Schedule();
        await JS.InvokeVoidAsync("poSfx.play", "chime");
    }

    private async Task SetAsync(AppSetting setting, bool on)
    {
        await Switches.SetAsync(setting, on);
        if (setting == AppSettings.OnDeviceAi && on)
            _deviceReady = await LocalAi.IsVisionReadyAsync();
        await JS.InvokeVoidAsync("poSfx.play", "tick");
    }

    /// <summary>Downloads the on-device vision model and runs it once, so Create can use it straight away.</summary>
    private async Task WarmUpAsync()
    {
        _warming = "Starting…";
        try
        {
            await LocalAi.WarmUpAsync(new Progress<LocalInferenceStatus>(status =>
            {
                _warming = status.LoadPercent is { } percent ? $"Downloading: {percent}%" : "Loading the model…";
                InvokeAsync(StateHasChanged);
            }));
            _deviceReady = true;
            _warming = null;
        }
        catch (LocalInferenceException ex)
        {
            _warming = null;
            Notifications.Notify(NotificationSeverity.Error, "The model could not be readied", LocalAiErrorClassifier.Describe(ex.Failure), 8000);
        }
    }

    // Sign-out is a POST with the antiforgery token; the page then leaves for /login itself.
    private async Task SignOutAsync()
    {
        _leaving = true;
        try
        {
            using var response = await Http.PostAsync("logout", null);
        }
        catch (HttpRequestException)
        {
            // Offline: the cookie stays, and /login will send a signed-in user back in.
        }

        Navigation.NavigateTo("login", forceLoad: true);
    }

    public void Dispose() => Switches.Changed -= OnSwitchesChanged;
}
