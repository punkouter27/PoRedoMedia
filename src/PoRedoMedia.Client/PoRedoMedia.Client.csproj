<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- Trim- and AOT-unsafe code breaks the build (the trim analyzer is on for every project in
         Directory.Build.props); JSON goes through the source-generated WireJson, not reflection. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <!-- IL2111: the Razor compiler's generated code for <Router> sets the framework's
         reflection-annotated NotFoundPage property. Not user code, nothing to fix here. -->
    <NoWarn>$(NoWarn);IL2111</NoWarn>
    <!-- Shown bottom-right by MainLayout; see Directory.Build.targets. -->
    <StampBuildVersion>true</StampBuildVersion>
    <!-- The [JSImport] source generator (LocalAi/LocalAiBytes.cs) emits pointer code; nothing
         hand-written here is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PoRedoMedia.Shared\PoRedoMedia.Shared.csproj" />
  </ItemGroup>

</Project>
