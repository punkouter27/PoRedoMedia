@* The Po shell header, on every page signed in or out (MainLayout and BareLayout): the app's name top-left, then on
   wide screens the places to go, and top-right the signed-in email (or Sign in) and the Settings gear. *@
@inject NavigationManager Navigation

<header class="po-header">
    <a class="po-header__title" href="/">PoRedoMedia</a>
    <AuthorizeView>
        <Authorized>
            <ShellNav Label="Main" Class="shell-nav" />
            <div class="po-header__actions">
                <RunsButton Class="shell-runs" />
                <span class="po-header__email" title="@AccountMenu.Email(context.User)">@AccountMenu.Email(context.User)</span>
                <SettingsButton />
            </div>
            <RunNotifier />
        </Authorized>
        <NotAuthorized>
            <div class="po-header__actions">
                @if (!OnLogin)
                {
                    <a class="po-link-btn filled small" href="login">Sign in</a>
                }
                <SettingsButton />
            </div>
        </NotAuthorized>
    </AuthorizeView>
</header>

@code {
    private bool OnLogin => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase);
}
