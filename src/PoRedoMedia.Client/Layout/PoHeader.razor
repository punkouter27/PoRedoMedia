@* The Po shell header, on every page signed in or out (MainLayout and BareLayout, so the sign-in page too): the app's
   name top-left, then on wide screens the places to go, and top-right the signed-in email (or one Sign in button, the
   same on every page). There is no Settings gear (the owner's call, 2026-11-20: the switches are fixed in
   Services/AppSettings); Sign out is in a small menu under the email. *@
@inject NavigationManager Navigation
@inject MediaApi Media

<header class="po-header">
    <a class="po-header__title" href="/">PoRedoMedia</a>
    <AuthorizeView>
        <Authorized>
            <ShellNav Label="Main" Class="shell-nav" />
            <div class="po-header__actions">
                <RunsButton Class="shell-runs" />
                <details class="account-menu">
                    <summary class="po-header__email" title="@AccountMenu.Email(context.User)">@AccountMenu.Email(context.User)</summary>
                    <div class="account-menu__panel">
                        <RadzenButton Text="@(_leaving ? "Signing out…" : "Sign out")" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@_leaving" Click="SignOutAsync" />
                    </div>
                </details>
            </div>
            <RunNotifier />
        </Authorized>
        <NotAuthorized>
            <div class="po-header__actions">
                @* On the sign-in page itself its card is the one way in, so the header shows only the title there. *@
                @if (!OnSignInPage)
                {
                    <a class="po-link-btn filled small" href="login">Sign in</a>
                }
            </div>
        </NotAuthorized>
    </AuthorizeView>
</header>

@code {
    private bool _leaving;

    private bool OnSignInPage => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Equals("login", StringComparison.OrdinalIgnoreCase);

    private async Task SignOutAsync()
    {
        _leaving = true;
        try
        {
            await Media.SignOutAsync();
        }
        catch (HttpRequestException)
        {
            // Offline: the cookie stays, and /login will send a signed-in user back in.
        }

        Navigation.NavigateTo("login", forceLoad: true);
    }
}
