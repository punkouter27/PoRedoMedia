@using System.Reflection

@* The Po build stamp, vYYMMDD (the UTC date of the commit built, stamped as the BuildVersion
   assembly metadata by Directory.Build.props), bottom-right on every page, as the page's footer landmark.
   The server reports the same value (/api/diag, Common/Health/HealthEndpoints). *@
<footer class="po-version">v@(Stamp)</footer>

@code {
    private static readonly string? Stamp = typeof(BuildVersion).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value;
}
