@* Wraps one page's body: when something on it fails, a small box offers to draw the page again
   (no reload, so the header, the nav and any run in progress carry on) and, if that is not
   enough, to reload. The layout's own boundary stays as the last resort. A new address
   recovers on its own. *@
@implements IDisposable
@inject NavigationManager Navigation

<ErrorBoundary @ref="_boundary">
    <ChildContent>@ChildContent</ChildContent>
    <ErrorContent>
        <div class="page-error" role="alert">
            <RadzenIcon Icon="error_outline" aria-hidden="true" class="page-error-icon" />
            <div class="page-error-text">
                <strong>This part of the page stopped working.</strong>
                <span>@(_tries > 1 ? "It failed again. Reloading starts the app afresh." : "Try it again; nothing you made is lost.")</span>
            </div>
            <div class="page-error-actions">
                <RadzenButton Text="Try again" Icon="refresh" Click="RetryAsync" />
                <RadzenButton Text="Reload the page" Variant="Variant.Outlined" Click="@(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true))" />
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Run before the page is drawn again, so a page can read its data afresh.</summary>
    [Parameter] public EventCallback OnRetry { get; set; }

    private ErrorBoundary? _boundary;
    private int _tries;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private async Task RetryAsync()
    {
        _tries++;
        await OnRetry.InvokeAsync();
        _boundary?.Recover();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        _tries = 0;
        _boundary?.Recover();
    });

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
