@* The signed-in user's button: their initial and name (the name hides on phones). It opens Settings, whose top card
   is the account and sign out. Settings itself has its own gear beside it (SettingsButton). *@

@* The accessible name starts with the visible name, so speech input can say what is shown. *@
<a href="settings" class="shell-account" aria-label="@($"{Name}: account")" title="Account and sign out">
    <span class="shell-avatar" aria-hidden="true" data-initial="@AccountMenu.Initial(Name)"></span>
    <span class="shell-account-name">@Name</span>
</a>

@code {
    [Parameter, EditorRequired] public string? Name { get; set; }
}
