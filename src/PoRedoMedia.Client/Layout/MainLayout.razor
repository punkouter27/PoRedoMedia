@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject PreferenceSync Preferences

<RadzenComponents />
<ShortcutKeys />

@* An app shell the height of the screen: only the body scrolls, so the header, the page's own
   command bar and the phone tab bar stay where they are. *@
<RadzenLayout>
    <RadzenHeader>
        <div class="shell-bar">
            <a href="" class="shell-home" title="Home">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span" class="rz-m-0 po-inherit shell-brand">PoRedoMedia</RadzenText>
            </a>
            <AuthorizeView>
                <Authorized>
                    <ShellNav Label="Main" Class="shell-nav" />
                    <div class="shell-tools">
                        <RunsButton Class="shell-runs" />
                        <AccountButton Name="@context.User.Identity?.Name" />
                    </div>
                    <RunNotifier />
                </Authorized>
                <NotAuthorized>
                    <div class="shell-tools">
                        <AccountButton />
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </RadzenHeader>
    <RadzenBody>
        <MockDataBanner />
        <main class="shell-main">
            @* The last resort: each page has its own PageBoundary inside this one. *@
            <ErrorBoundary @ref="_boundary">
                <ChildContent>@Body</ChildContent>
                <ErrorContent>
                    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0">
                        Something went wrong on this page.
                        <RadzenButton Text="Reload" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Light" class="rz-ml-2"
                                      Click="@(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true))" />
                    </RadzenAlert>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </RadzenBody>
    <AuthorizeView>
        <Authorized>
            @* Phones only: the stylesheet hides it on wider screens, where the header has room. *@
            <BottomNav />
        </Authorized>
    </AuthorizeView>
</RadzenLayout>

<BuildVersion />

@code {
    [CascadingParameter] private Task<AuthenticationState>? Auth { get; set; }

    private ErrorBoundary? _boundary;

    // Signed in: the account's settings and recipes replace this browser's (Services/PreferenceSync).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Auth is not null && (await Auth).User.Identity?.IsAuthenticated == true)
            await Preferences.PullAsync();
    }

    // A page that failed must not keep the next page from showing.
    protected override void OnParametersSet() => _boundary?.Recover();
}
