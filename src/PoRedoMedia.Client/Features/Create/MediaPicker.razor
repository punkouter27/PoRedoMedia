@* Choosing the media for a run: drop, paste, pick a file, use the camera, or take a file another
   app shared. Something already in the Library is reused from there ("Use as source"). *@
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject BlobUploadService Uploader
@inject AppConfigService Config
@inject IJSRuntime JS
@inject DialogService Dialogs

@* Leaving mid-upload dropped the file without a word: now the browser asks first (reload, close), and so does the app (its own links). *@
<NavigationLock ConfirmExternalNavigation="Busy" OnBeforeInternalNavigation="ConfirmLeaveAsync" />
<RadzenStack Gap="1rem">
    <div class="picker-drop po-glass" @ref="_zone">
        @if (Multiple)
        {
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Choose your videos</RadzenText>
            <RadzenText class="rz-m-0">Drop them here, or pick several files at once. Each one goes in your Library and in the list.</RadzenText>
            <RadzenText class="rz-m-0">MP4, MOV or WEBM, up to 200 MB and 1 minute each.</RadzenText>
            <FilePick @ref="_file" Text="Choose files" Disabled="Busy" Accept="@Accept" Multiple="true" OnChange="UploadAsync" />
        }
        else
        {
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2" class="rz-m-0">Choose a photo or a video</RadzenText>
            <RadzenText class="rz-m-0">Drop it here, paste it, pick a file, or use the camera for a photo or a video.</RadzenText>
            <RadzenText class="rz-m-0">JPG, PNG or WEBP (big photos are shrunk to fit), GIF up to 10 MB. MP4, MOV or WEBM up to 200 MB and 1 minute.</RadzenText>
            <FilePick @ref="_file" Text="Choose file" Disabled="Busy" Accept="@Accept" OnChange="UploadAsync" />
        }
        @if (_hasCamera && !_cameraOn)
        {
            <RadzenButton Text="Use the camera" Icon="photo_camera" Variant="Variant.Outlined" Disabled="Busy" Click="StartCameraAsync" />
        }
        <video @ref="_camera" class="picker-camera" hidden="@(!_cameraOn)" playsinline muted aria-label="Camera preview"></video>
        @if (_cameraOn)
        {
            @* The script writes the running time into this, so it is always there to be written to. *@
            <span @ref="_clock" class="picker-rec" role="status" hidden="@(!_recording)"></span>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.Center">
                @if (_recording)
                {
                    <RadzenButton Text="Stop and use the video" Icon="stop_circle" ButtonStyle="ButtonStyle.Danger" Click="StopRecordingAsync" />
                }
                else
                {
                    <RadzenButton Text="Take the photo" Icon="camera" Click="TakePhotoAsync" />
                    <RadzenButton Text="Record a video" Icon="videocam" Variant="Variant.Outlined" Click="StartRecordingAsync" />
                }
                <RadzenButton Text="Cancel" Variant="Variant.Outlined" Click="StopCameraAsync" />
            </RadzenStack>
        }
        @if (_percent is { } percent)
        {
            <RadzenProgressBar Value="percent" aria-label="Upload progress" class="po-fill" />
        }
        @if (_status is not null)
        {
            <RadzenText class="rz-m-0" aria-live="polite">@_status</RadzenText>
        }
        @if (_error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0">@_error</RadzenAlert>
        }
    </div>
</RadzenStack>

@code {
    [Parameter] public EventCallback<MediaDto> ValueChanged { get; set; }

    /// <summary>Another app shared a file to this one: pick it up as if it had been chosen here.</summary>
    [Parameter] public bool TakeShared { get; set; }

    /// <summary>Several files at once, each uploaded in turn and handed on as it is ready (a movie's films).</summary>
    [Parameter] public bool Multiple { get; set; }

    /// <summary>What the file chooser offers; every kind this app takes unless narrowed.</summary>
    [Parameter] public string Accept { get; set; } = FilePick.MediaTypes;

    /// <summary>Raised once every file of a choice has been uploaded (or refused).</summary>
    [Parameter] public EventCallback BatchDone { get; set; }

    /// <summary>The server's picture limit (Api's <c>UploadValidation.MaxImageBytes</c>); bigger photos are shrunk before sending.</summary>
    private const long MaxImageBytes = 10L * 1024 * 1024;

    /// <summary>The most files one choice takes.</summary>
    private const int MostFiles = 20;

    private double? _percent;
    private string? _error;
    private string? _status;
    private FilePick? _file;

    private ElementReference _zone;
    private ElementReference _camera;
    private ElementReference _clock;
    private bool _hasCamera;
    private bool _cameraOn;
    private bool _recording;
    private bool _rendered;

    private bool Busy => _percent is not null || _status is not null;

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (Busy && await Dialogs.Confirm("Your upload has not finished. Leave anyway? It will be lost.", "Upload in progress", new ConfirmOptions { OkButtonText = "Leave", CancelButtonText = "Stay" }) != true)
            context.PreventNavigation();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _rendered = true;
        await JS.InvokeVoidAsync("poMedia.acceptDropAndPaste", _zone, _file!.Element);
        _hasCamera = await JS.InvokeAsync<bool>("poMedia.hasCamera");
        StateHasChanged();
        if (TakeShared)
            await JS.InvokeAsync<bool>("poMedia.takeShared", _file.Element);
    }

    private async Task StartCameraAsync()
    {
        _cameraOn = await JS.InvokeAsync<bool>("poMedia.startCamera", _camera);
        _error = _cameraOn ? null : "The camera could not be opened. Check that this site is allowed to use it.";
    }

    private async Task TakePhotoAsync()
    {
        // The photo arrives through the file input, exactly as a chosen file does.
        await JS.InvokeAsync<bool>("poMedia.takePhoto", _camera, _file!.Element);
        _cameraOn = false;
    }

    private async Task StartRecordingAsync()
    {
        _recording = await JS.InvokeAsync<bool>("poMedia.startRecording", _camera, _file!.Element, _clock);
        _error = _recording ? null : "This browser cannot record video here. Record one with your camera app and choose the file instead.";
    }

    // The clip arrives through the file input, as a photo does, and the upload starts from there.
    // The script also stops by itself at the length limit, so the buttons are reset in UploadAsync.
    private async Task StopRecordingAsync() => await JS.InvokeVoidAsync("poMedia.stopRecording", _camera);

    private async Task StopCameraAsync()
    {
        await JS.InvokeVoidAsync("poMedia.stopCamera", _camera);
        (_cameraOn, _recording) = (false, false);
    }

    private async Task UploadAsync(InputFileChangeEventArgs e)
    {
        // A second choice made while the first is still going is ignored.
        if (Busy)
            return;

        var input = _file!.Element;
        var files = Multiple ? e.GetMultipleFiles(MostFiles) : [e.File];
        var refused = new List<string>();
        (_error, _cameraOn, _recording) = (null, false, false);
        for (var i = 0; i < files.Count; i++)
        {
            var file = files[i];
            var which = files.Count > 1 ? $"{i + 1} of {files.Count} · {file.Name}: " : "";
            // Read from the file's own header, so a clip that is too long is refused before it is sent.
            // The server measures again after the upload; the slack is the one it allows.
            if (await JS.InvokeAsync<double>("poMedia.videoSeconds", input, i) > 62)
            {
                refused.Add(files.Count > 1 ? $"{file.Name} is longer than a minute." : "Videos can be up to 1 minute long. Shorten it, then choose it again.");
                continue;
            }

            // A photo over the limit is shrunk here first, as the phone app does; a GIF would lose its animation.
            var (name, size) = (file.Name, file.Size);
            if (size > MaxImageBytes && file.ContentType.StartsWith("image/", StringComparison.Ordinal) && file.ContentType != "image/gif")
            {
                _status = $"{which}Making the photo small enough to send…";
                StateHasChanged();
                var fitted = await JS.InvokeAsync<long>("poMedia.fitImage", input, i);
                _status = null;
                if (fitted > 0)
                    (name, size) = (Path.ChangeExtension(file.Name, ".jpg"), fitted);
            }

            (_percent, _status) = (0, files.Count > 1 ? $"Uploading {which.TrimEnd(':', ' ')}" : null);
            StateHasChanged();
            var (media, error) = await Uploader.UploadAsync(input, name, size, percent =>
            {
                _percent = percent;
                InvokeAsync(StateHasChanged);
            }, i);
            _percent = null;
            if (error is not null)
                refused.Add(files.Count > 1 ? $"{file.Name}: {error}" : error);

            if (media is { Kind: MediaKind.Video })
            {
                // Analysed once, here, while the browser still has the file. Every later run reuses it.
                _status = $"{which}Looking through the video…";
                StateHasChanged();
                await JS.InvokeAsync<int>("poMedia.analyseVideo", input, media.Id, i);

                // No speech model on the server: the browser's own hears the video instead.
                if ((await Config.GetAsync())?.ServerSpeech == false)
                {
                    _status = $"{which}Listening to the video on your device…";
                    StateHasChanged();
                    using var progress = DotNetObjectReference.Create(new BlobUploadService.ProgressSink(percent =>
                    {
                        _status = percent >= 0 ? $"Getting the on-device speech model ready: {percent}%" : $"{which}Listening to the video on your device…";
                        InvokeAsync(StateHasChanged);
                    }));
                    await JS.InvokeAsync<int>("poDeviceAi.transcribeVideo", input, media.Id, progress, i);
                }
            }

            _status = null;
            if (media is not null)
                await ValueChanged.InvokeAsync(media);
        }

        _error = refused.Count > 0 ? string.Join(" ", refused) : null;
        // Emptied, so choosing the same file again is a change the input reports.
        await JS.InvokeVoidAsync("poMedia.clearFile", input);
        await BatchDone.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (!_rendered)
            return;

        try
        {
            // Leaving the page must turn the camera off and take the paste listener with it.
            await JS.InvokeVoidAsync("poMedia.stopCamera", _camera);
            await JS.InvokeVoidAsync("poMedia.releaseDropAndPaste", _zone);
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; so are the camera and the listeners.
        }
    }
}
