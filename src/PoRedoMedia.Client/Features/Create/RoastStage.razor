@* A roast performed: the track, with the line being delivered lit up and the stage pulsing to
   the track's loudness. A line starts the track from there. The picture and the words can be
   saved together as a card, or recorded with the track as a video. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NotificationService Notifications

<div class="roast-stage" @ref="_stage">
    @* Concert mode's screen, filled and driven by js/fx/concert.js while the track plays. *@
    <div class="roast-fx po-fx-only" aria-hidden="true"></div>
    <audio @ref="_audio" src="@Media.Url" controls preload="metadata" aria-label="@Media.Title"></audio>
    <canvas class="po-wave po-fx-only" aria-hidden="true"></canvas>
    <ol class="roast-lines" aria-label="Lyrics. Pick a line to play from there.">
        @foreach (var line in Lines)
        {
            @* js/roast-stage.js lights the line being delivered and plays from a clicked line ([data-line]). *@
            <li><RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" class="po-plain roast-line" data-line="">@line</RadzenButton></li>
        }
    </ol>
    <div class="roast-sync" role="group" aria-label="Lyric timing">
        <RadzenLabel Text="Lyric timing" Component="roast-sync" />
        <RadzenSlider Name="roast-sync" TValue="double" Min="-3" Max="3" Step="0.1" Value="@_offset" Change="SyncAsync" />
        <output>@SyncText</output>
        <RadzenButton Text="@(_wordSyncing ? "Syncing…" : _wordSynced ? "Word-synced" : "Word sync")" Icon="graphic_eq"
                      Size="ButtonSize.ExtraSmall" Variant="@(_wordSynced ? Variant.Filled : Variant.Outlined)"
                      IsBusy="_wordSyncing" Disabled="_wordSyncing" Click="WordSyncAsync"
                      title="Align every lyric line to the vocal track using on-device Whisper word timestamps" />
    </div>
    @if (Media.ParentId is not null)
    {
        <div class="roast-exports">
            <RadzenButton Text="Save as a card" Icon="image" Size="ButtonSize.Small" Variant="Variant.Outlined" IsBusy="_saving" Disabled="_recording is not null" Click="SaveCardAsync" />
            <RadzenSelectBar TValue="string" @bind-Value="_cut" Size="ButtonSize.Small" Disabled="@(_recording is not null)" aria-label="Video style">
                <Items>
                    <RadzenSelectBarItem Text="Meme cut" Value="@("meme")" />
                    <RadzenSelectBarItem Text="Classic" Value="@("classic")" />
                </Items>
            </RadzenSelectBar>
            <RadzenButton Text="@(_recording is { } percent ? $"Recording {percent}%" : "Export video")" Icon="movie" Size="ButtonSize.Small" Variant="Variant.Outlined"
                          Disabled="@(_recording is not null || _saving)" Click="ExportVideoAsync" />
        </div>
    }
    @if (Media.Detail is not null)
    {
        <details class="roast-saw">
            <summary>What the AI saw</summary>
            <p>@Media.Detail</p>
        </details>
    }
</div>

@code {
    [Parameter, EditorRequired] public MediaDto Media { get; set; } = null!;

    private ElementReference _stage;
    private ElementReference _audio;
    private bool _attached;
    private bool _saving;
    private bool _wordSyncing;
    private bool _wordSynced;
    private string _cut = "meme";
    private int? _recording;
    private double _offset;

    /// <summary>How far the lyric timings are moved, in words: they are an estimate, and the slider nudges them all.</summary>
    private string SyncText => Math.Abs(_offset) < 0.05 ? "on the beat" : $"{(_offset > 0 ? "+" : "")}{_offset.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)}s";

    private async Task SyncAsync(double offset)
    {
        _offset = offset;
        if (_attached)
            await JS.InvokeVoidAsync("poRoast.offset", _stage, offset);
    }

    private async Task WordSyncAsync()
    {
        if (!_attached || _wordSyncing)
            return;

        _wordSyncing = true;
        try
        {
            _wordSynced = await JS.InvokeAsync<bool>("poRoast.syncWords", _stage);
            if (_wordSynced)
                Notifications.Notify(NotificationSeverity.Success, "Lyrics word-synced", "Lines now track exact vocal timestamps.", 4000);
            else
                Notifications.Notify(NotificationSeverity.Warning, "Could not word-sync", "Keeping estimated line timings.", 5000);
        }
        finally
        {
            _wordSyncing = false;
        }
    }

    private string PictureUrl => $"api/media/{Media.ParentId}/content";

    private IEnumerable<string> Lines =>
        (Media.Text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _attached = true;
        await JS.InvokeVoidAsync("poRoast.attach", _stage, _audio);
    }

    private async Task SaveCardAsync()
    {
        _saving = true;
        var saved = await JS.InvokeAsync<bool>("poRoast.card", PictureUrl, Media.Title, Media.Text ?? "");
        _saving = false;
        if (!saved)
            Notifications.Notify(NotificationSeverity.Error, "Could not make the card", "The picture this roast was made from is no longer in your gallery.", 8000);
    }

    /// <summary>Recorded in the browser while the track plays, so it takes as long as the track.</summary>
    private async Task ExportVideoAsync()
    {
        _recording = 0;
        using var progress = DotNetObjectReference.Create(new BlobUploadService.ProgressSink(percent =>
        {
            _recording = percent;
            InvokeAsync(StateHasChanged);
        }));
        var saved = await JS.InvokeAsync<bool>("poRoast.video", PictureUrl, Media.Url, Media.Text ?? "", _cut == "meme", progress);
        _recording = null;
        if (!saved)
            Notifications.Notify(NotificationSeverity.Error, "Could not record the video", "This browser cannot record video, or the picture this roast was made from is gone.", 8000);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_attached)
            return;

        try
        {
            await JS.InvokeVoidAsync("poRoast.detach", _stage);
        }
        catch (JSDisconnectedException)
        {
            // The page is going away, and the stage with it.
        }
    }
}
