@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation

<PageTitle>Sign in · PoRedoMedia</PageTitle>

<PageBoundary>
<RadzenStack AlignItems="AlignItems.Center" class="rz-mt-12">
    <RadzenCard class="po-narrow po-pop">
        <RadzenStack Gap="1rem">
            @* The sign-in page shows the app's name and the way in, nothing else (Po standard). *@
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">PoRedoMedia</RadzenText>
            @if (Denied == true)
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-m-0">
                    The sign-in did not finish, or this account is not allowed to use this app.
                </RadzenAlert>
            }
            @* Exactly one button, in every environment. Development and Test sign in without Microsoft by opening
               /dev-login?email=…&returnUrl=/path (a server route that does not exist in Production; README). *@
            <RadzenButton Text="Sign in with Microsoft" Disabled="_leaving" Click="@(() => Go("challenge-microsoft"))" />
        </RadzenStack>
    </RadzenCard>
</RadzenStack>
</PageBoundary>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    /// <summary>Set by the server when Microsoft sign-in was refused or abandoned.</summary>
    [SupplyParameterFromQuery] public bool? Denied { get; set; }

    private bool _leaving;

    // These are server routes, so the browser must leave the app to reach them.
    private void Go(string path)
    {
        _leaving = true;
        var separator = path.Contains('?') ? '&' : '?';
        var target = string.IsNullOrEmpty(ReturnUrl) ? path : $"{path}{separator}returnUrl={Uri.EscapeDataString(ReturnUrl)}";
        Navigation.NavigateTo(target, forceLoad: true);
    }
}
