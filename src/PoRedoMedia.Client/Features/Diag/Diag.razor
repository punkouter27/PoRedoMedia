@page "/diag"
@attribute [AllowAnonymous]
@* How the server and what it depends on are doing, in plain words, for anyone (no sign-in). Everything comes from
   GET /api/diag, which runs the server's health checks and says nothing identifying (DiagReportDto). *@
@inject HttpClient Http

<PageTitle>System status</PageTitle>

<PageBoundary>
<div class="po-diag diag-page">
    <div class="diag-head">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-m-0">System status</RadzenText>
        <RadzenButton Text="@(_loading ? "Checking…" : "Refresh")" Icon="refresh" Variant="Variant.Outlined" Disabled="_loading" IsBusy="_loading" Click="LoadAsync" />
    </div>

    @if (_report is null && _loading)
    {
        <RadzenCard class="diag-card" role="status" aria-label="Checking the server">
            <RadzenStack Gap="0.6rem">
                <div class="po-skeleton diag-skeleton"></div>
                <div class="po-skeleton diag-skeleton"></div>
                <div class="po-skeleton diag-skeleton"></div>
            </RadzenStack>
        </RadzenCard>
    }
    else if (_error is not null)
    {
        <div class="po-diag__banner po-diag__banner--bad" role="alert">
            <strong>Not working: the server did not answer</strong>
            <span>@_error Try Refresh in a moment.</span>
        </div>
    }

    @if (_report is { } report)
    {
        <div class="po-diag__banner po-diag__banner--@Banner(report.Checks)" role="status">
            <strong>@Headline(report.Checks)</strong>
            <span>@Summary(report.Checks)</span>
        </div>

        <section class="po-diag__group" aria-labelledby="diag-api">
            <h2 id="diag-api" class="diag-group">API</h2>
            @Rows(report.Checks.Where(c => c.Group == "api"))
        </section>

        <section class="po-diag__group" aria-labelledby="diag-data">
            <h2 id="diag-data" class="diag-group">Data</h2>
            @Rows(report.Checks.Where(c => c.Group == "data"))
        </section>

        <section class="po-diag__group" aria-labelledby="diag-services">
            <h2 id="diag-services" class="diag-group">Services</h2>
            @Rows(report.Checks.Where(c => c.Group != "api" && c.Group != "data"))
        </section>

        <p class="diag-meta">
            Version @report.Version · @report.Environment · checks took @Ms(report.CheckedMs) (@Ms(_roundTripMs) round trip)
            · last checked @report.CheckedAt.ToLocalTime().ToString("HH:mm:ss")
        </p>
    }
</div>
</PageBoundary>

@code {
    private DiagReportDto? _report;
    private string? _error;
    private bool _loading;
    private double _roundTripMs;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_loading) return;
        _loading = true;
        _error = null;
        var started = System.Diagnostics.Stopwatch.GetTimestamp();
        try
        {
            _report = await Http.GetFromJsonAsync("api/diag", WireJson.Default.DiagReportDto);
            _roundTripMs = System.Diagnostics.Stopwatch.GetElapsedTime(started).TotalMilliseconds;
            if (_report is null) _error = "The server sent nothing back.";
        }
        catch (HttpRequestException)
        {
            _report = null;
            _error = "The server could not be reached.";
        }
        catch (TaskCanceledException)
        {
            _report = null;
            _error = "The server took too long to answer.";
        }
        catch (System.Text.Json.JsonException)
        {
            _report = null;
            _error = "The server's answer could not be read.";
        }
        finally
        {
            _loading = false;
        }
    }

    // One row per check: label, purpose, status pill, latency, and the problem (or what was found).
    private RenderFragment Rows(IEnumerable<DiagCheckDto> checks) => __builder =>
    {
        var any = false;
        foreach (var check in checks)
        {
            any = true;
            <div class="po-diag__card">
                <div class="diag-what">
                    <strong>@check.Label</strong>
                    <span class="diag-meta">@check.Purpose</span>
                </div>
                <span class="po-badge po-badge--@Badge(check.Status)">@check.Status</span>
                <span class="diag-span">@(check.Problem ?? check.Detail) <span class="diag-meta">· @Ms(check.LatencyMs)</span></span>
            </div>
        }
        if (!any)
        {
            <p class="diag-meta">Nothing to check here.</p>
        }
    };

    private static string Ms(double ms) => ms < 1 ? "under 1 ms" : $"{ms:N0} ms";

    private static string Badge(string status) => status switch
    {
        "Healthy" => "ok",
        "Degraded" => "warn",
        _ => "bad",
    };

    private static string Banner(DiagCheckDto[] checks) =>
        checks.Any(c => c.Status == "Unhealthy") ? "bad" : checks.Any(c => c.Status == "Degraded") ? "warn" : "ok";

    // The standard's three plain-words headlines.
    private static string Headline(DiagCheckDto[] checks)
    {
        var down = checks.Where(c => c.Status == "Unhealthy").Select(c => c.Label).ToList();
        if (down.Count > 0) return $"Not working: {string.Join(", ", down)}";
        var degraded = checks.Count(c => c.Status == "Degraded");
        return degraded == 0 ? "Everything is working" : $"Working, with {degraded} {(degraded == 1 ? "thing" : "things")} degraded";
    }

    private static string Summary(DiagCheckDto[] checks)
    {
        var degraded = checks.Where(c => c.Status == "Degraded").Select(c => c.Label).ToList();
        if (checks.Any(c => c.Status == "Unhealthy"))
            return "Sign-in, the Library or making things may not work until this is fixed.";
        return degraded.Count == 0
            ? $"All {checks.Length} checks passed."
            : $"Degraded: {string.Join(", ", degraded)}. The app runs and offers less.";
    }
}
