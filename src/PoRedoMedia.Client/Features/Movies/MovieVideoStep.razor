@* The open movie's result: the finished video (render it again after changing the roast), with its
   chapters, thumbnail and upload details, send it to YouTube or download it (which removes the movie from the
   server: no video is kept there). *@
@implements IAsyncDisposable
@inject MovieStore Store
@inject FluentValidation.IValidator<MovieUploadRequest> UploadRules
@inject MovieApi Api
@inject DialogService Dialogs
@inject IJSRuntime JS
@inject RunApi Runs

@if (Store.Movie is { } movie && Store.Config is { } config)
{
var publish = movie.Publish;
<div class="mv-video">
    <div class="mv-side">
        <strong>Finished video</strong>
        <RadzenButton Text="@(publish.MasterUrl is null ? "Render finished video" : "Render again")" Icon="movie" Variant="@(publish.MasterUrl is null ? Variant.Filled : Variant.Outlined)" Disabled="@(Store.IsWorking || !config.Ffmpeg)" Click="RenderAsync" class="mv-wide"
                      title="@($"Build the finished video file with voice and pictures (no captions are drawn on it), plus a chapter list, a thumbnail and an upload description.{(config.Memes ? " Every film and AI video clip goes through Meme-ify first; you are shown what that costs and asked." : "")} A movie can be up to 10 minutes, each clip under one.")" />
        @if (publish.MasterUrl is { } master)
        {
            <video @ref="_masterVideo" class="mv-master" src="@master" controls preload="metadata" playsinline aria-label="The finished video"></video>
            <span class="mv-quiet">@publish.MasterName · @publish.MasterSize</span>
            <div class="mv-row mv-equal">
                <RadzenButton Text="@(_packing ? "Packing the download…" : "Download for YouTube & TikTok (.zip)")" Icon="download" Variant="Variant.Filled"
                              Disabled="@(_packing || Store.IsWorking)" IsBusy="_packing" Click="DownloadAsync" class="mv-wide"
                              title="One zip with everything to publish it: the video for YouTube, an upright 9:16 copy for TikTok, a YouTube thumbnail, the title, description, tags and caption for each site, and a README with the steps. Once the download finishes, the movie and all its files are removed from the server. Free." />
            </div>
            @if (_packError is { } packError)
            {
                <div class="po-field-error" role="alert">@packError</div>
            }
        }

        <h2 class="mv-section">Chapters</h2>
        <p class="mv-quiet">@(publish.MasterUrl is null ? "Render the finished video to see its chapters."
            : publish.Chapters.Trim().Length == 0 ? "No chapters: YouTube shows them only for three or more of ten seconds or longer, and this video is too short for that."
            : "Chapters, a beat to each, as YouTube reads them in a description. They are already in the description below.")</p>
        @if (publish.Chapters.Trim().Length > 0)
        {
            <pre class="mv-chapters">@publish.Chapters</pre>
        }

        <div class="mv-row mv-between">
            <h2 class="mv-section">Thumbnail</h2>
            <RadzenButton Text="Make thumbnails" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="@(Store.IsWorking || !config.Ffmpeg)" Click="@(() => Store.DoAsync("thumbnails", job: true))"
                          title="Make three 1280 by 720 thumbnails from your films and the movie's pictures, with its title in the series' colour. Then click the one to use. Free." />
        </div>
        <p class="mv-quiet">@(publish.ThumbnailUrl is null ? "No thumbnail chosen: YouTube picks a frame itself." : "Thumbnail chosen. It is sent with the upload.")</p>
        @if (publish.ThumbnailChoices.Length > 0)
        {
            <div class="mv-candidates wide" title="Click the thumbnail to use. It is kept with the movie and sent with the upload.">
                @for (var i = 0; i < publish.ThumbnailChoices.Length; i++)
                {
                    var choice = i;
                    <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" class="po-plain mv-thumb-choice" Click="@(() => Store.DoAsync($"thumbnail?index={choice}"))"><img src="@publish.ThumbnailChoices[choice]" alt="@($"Thumbnail {choice + 1}")" /></RadzenButton>
                }
            </div>
        }
        else if (publish.ThumbnailUrl is not null)
        {
            <img class="mv-inspector-picture" src="@publish.ThumbnailUrl" alt="The chosen thumbnail" />
        }

        <h2 class="mv-section">YouTube</h2>
        @if (publish.MasterUrl is null)
        {
            <p class="mv-quiet">Render the finished video first: its title, description and chapters are filled in from it, ready to send.</p>
        }
        else
        {
            Seed(movie);
            <div class="mv-field">
                <RadzenLabel Text="Title" Component="mv-up-title" />
                <div class="mv-row">
                    <RadzenTextBox Name="mv-up-title" @bind-Value="_title" MaxLength="100" class="mv-grow" title="The video's title on YouTube, up to 100 characters. Filled in from the titles written with the finished video." />
                    <RadzenButton Icon="content_copy" Variant="Variant.Text" Click="@(() => CopyAsync("Title", _title))" aria-label="Copy the title" title="Copy the title, to paste into YouTube's own upload page. Free." />
                </div>
                <FieldErrors Errors="_errors" For="Title" />
            </div>
            <div class="mv-field">
                <RadzenLabel Text="Description" Component="mv-up-description" />
                <div class="mv-row mv-top">
                    <RadzenTextArea Name="mv-up-description" @bind-Value="_description" Rows="6" class="mv-grow" title="The video's description on YouTube, with the chapter list in it so the video shows chapters. Change it as you like." />
                    <RadzenButton Icon="content_copy" Variant="Variant.Text" Click="@(() => CopyAsync("Description", _description))" aria-label="Copy the description" title="Copy the whole description, chapters and hashtags included, to paste into YouTube's own upload page. Free." />
                </div>
                <FieldErrors Errors="_errors" For="Description" />
            </div>
            <div class="mv-field">
                <RadzenLabel Text="Tags" Component="mv-up-tags" />
                <div class="mv-row">
                    <RadzenTextBox Name="mv-up-tags" @bind-Value="_tags" Placeholder="family, weekend" class="mv-grow" title="Search tags, separated by commas. YouTube keeps 500 characters of them; the rest are left off." />
                    <RadzenButton Icon="content_copy" Variant="Variant.Text" Click="@(() => CopyAsync("Tags", _tags))" aria-label="Copy the tags" title="Copy the tags, to paste into the Tags box under Show more on YouTube's upload page. Free." />
                </div>
            </div>
            <div class="mv-field">
                <RadzenLabel Text="Who can watch" Component="mv-up-privacy" />
                <RadzenDropDown Name="mv-up-privacy" TValue="string" Data="@Privacies" @bind-Value="_privacy"
                                title="Private: only you. Unlisted: anyone with the link. Public: everyone. Private is safest; change it on YouTube once you have watched it there." />
                <FieldErrors Errors="_errors" For="Privacy" />
            </div>
            <p class="mv-quiet">Uploaded as not made for kids, so comments and notifications stay on.</p>
            @if (Store.Advanced)
            {
                <div class="mv-field">
                    <RadzenLabel Text="Goes public on (optional)" Component="mv-up-when" />
                    <RadzenDatePicker Name="mv-up-when" TValue="DateTime?" @bind-Value="_publishAt" ShowTime="true" HourFormat="24" DateFormat="d MMM yyyy, HH:mm" Placeholder="Not scheduled" AllowClear="true"
                                      title="The day and time the video goes public by itself. It is uploaded private until then, whatever is chosen above. Leave it empty for no schedule." />
                    <FieldErrors Errors="_errors" For="PublishAt" />
                </div>
            }
            @if (config.YouTube)
            {
                <div class="mv-field">
                    <RadzenLabel Text="Replaces on YouTube (optional)" Component="mv-up-replace" />
                    <div class="mv-row">
                        <RadzenTextBox Name="mv-up-replace" @bind-Value="_replace" Placeholder="https://youtu.be/…" class="mv-grow"
                                       title="The link of a video on your channel (from YouTube or YouTube Studio). Upload to YouTube then puts the new render up and, once it is up, deletes this one. YouTube cannot swap a video's file, so the new one gets a new link and the old one's views and likes go with it." />
                        <RadzenButton Text="Delete from YouTube" Icon="delete" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                      Disabled="@(_uploading || Store.IsWorking || YouTubeLinks.VideoId(_replace) is null)" Click="DeleteFromYouTubeAsync"
                                      title="Delete the video at this link from your channel, for good, and upload nothing. A new tab opens to sign in to Google first." />
                    </div>
                    <FieldErrors Errors="_errors" For="Replace" />
                    @if (YouTubeLinks.VideoId(_replace) is { } replacing)
                    {
                        var known = publish.YouTube?.LastOrDefault(e => e.Kind == "uploaded" && YouTubeLinks.VideoId(e.Link) == replacing);
                        <span class="mv-quiet">
                            @(known is null ? "A video on your channel." : $"This is “{known.Title}”, uploaded {known.At.ToLocalTime():d MMM, HH:mm}.")
                            Upload to YouTube puts the new render up first, then deletes it. Delete from YouTube deletes it and uploads nothing.
                        </span>
                    }
                </div>
            }
            <span title="@(config.YouTube
                ? "Send the finished video to your YouTube channel with this title, description, tags and privacy, and the chosen thumbnail. A new tab opens to sign in to Google each time; nothing is kept. Free."
                : "Uploading needs this server's Google sign-in: a Google Cloud OAuth client of the Web application kind, with the YouTube Data API on, set as YouTube:ClientId and YouTube:ClientSecret.")">
                <RadzenButton Text="Upload to YouTube" Icon="upload" Disabled="@(_uploading || Store.IsWorking || !config.YouTube)" IsBusy="_uploading" Click="UploadAsync" class="mv-wide" />
            </span>
            @if (!config.YouTube)
            {
                <p class="mv-quiet">Uploading to YouTube is not set up on this server. Download the video, or copy the title, description and tags, and upload it on YouTube's own page.</p>
            }
        }
        @if (_signIn is not null)
        {
            <div class="mv-yt-step" role="status">
                <strong><RadzenIcon Icon="login" /> Next: sign in to Google</strong>
                <span>Google opens in a new tab. Choose the channel and allow PoRedoMedia @(_signInFor == "delete" ? "to delete the video" : "to upload"), then come back to this tab: @(_signInFor == "delete" ? "the video is deleted" : "the upload starts") by itself, and its progress shows at the bottom of the page.</span>
                <div class="mv-row">
                    <LinkButton Href="@_signIn" Text="Sign in to Google" Icon="open_in_new" target="_blank" rel="noopener" title="Opens Google in a new tab, for this alone. Nothing is kept." />
                    <RadzenButton Text="Cancel" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => { _signIn = null; Store.Say("Cancelled. Nothing was sent to YouTube."); })" />
                </div>
                <span class="mv-quiet mv-row"><RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" /> Waiting for you to sign in…</span>
            </div>
        }
        @if (publish.YouTube is { Length: > 0 } done)
        {
            <h3 class="mv-section">On YouTube</h3>
            <ul class="mv-yt-log" aria-label="What has been done on YouTube for this movie, newest first">
                @foreach (var e in done.Reverse().Take(10))
                {
                    var item = e;
                    var gone = item.Kind == "uploaded" && done.Any(d => d.Kind == "deleted" && d.At >= item.At && YouTubeLinks.VideoId(d.Link) == YouTubeLinks.VideoId(item.Link));
                    <li class="mv-yt-item @item.Kind">
                        <RadzenIcon Icon="@(item.Kind switch { "uploaded" => gone ? "cloud_off" : "cloud_done", "deleted" => "delete", _ => "error" })" />
                        <div class="mv-yt-text">
                            <strong>@(item.Kind switch { "uploaded" => item.Replaced is null ? "Uploaded" : "Uploaded, replacing a video", "deleted" => "Deleted", _ => "Did not work" })</strong>
                            @if (item.Title.Length > 0)
                            {
                                <span>“@item.Title”</span>
                            }
                            <span class="mv-quiet">@item.At.ToLocalTime().ToString("d MMM yyyy, HH:mm")@(item.Privacy.Length > 0 ? $" · {item.Privacy}" : "")@(gone ? " · deleted since" : "")</span>
                            @if (item.Link.Length > 0)
                            {
                                <a href="@item.Link" target="_blank" rel="noopener" class="@(gone || item.Kind == "deleted" ? "mv-yt-gone" : null)">@item.Link</a>
                            }
                            @if (item.Replaced is { } replaced)
                            {
                                <span class="mv-quiet">Replaced @replaced, which was deleted.</span>
                            }
                            @if (item.Problem is { } trouble)
                            {
                                <span class="@(item.Kind == "failed" ? "po-field-error" : "mv-quiet")">@trouble</span>
                            }
                        </div>
                        @if (item.Kind == "uploaded" && !gone)
                        {
                            <span class="mv-row">
                                <RadzenButton Icon="content_copy" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => CopyAsync("Link", item.Link))" aria-label="Copy the link" title="Copy the video's link." />
                                <RadzenButton Icon="swap_horiz" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => { _replace = item.Link; })" aria-label="Replace it next time"
                                              title="Put this video in Replaces on YouTube, so the next upload replaces it (or Delete from YouTube deletes it)." />
                            </span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
</div>
}

@code {
    private static readonly string[] Privacies = MovieUploadRequestValidator.Privacies;

    /// <summary>The same rules POST /api/movies/{id}/youtube runs.</summary>

    /// <summary>The upload form's messages from the last check, or null.</summary>
    private IDictionary<string, string[]>? _errors;

    /// <summary>True from the press until Google's sign-in link is back, so one press is one upload.</summary>
    private bool _uploading;

    private string _title = "", _description = "", _tags = "", _privacy = "Private";

    /// <summary>The video the next upload replaces (or Delete from YouTube deletes); filled in with the last one uploaded from here.</summary>
    private string _replace = "";
    private string? _lastUploaded;
    private string? _seeded;
    private DateTime? _publishAt;
    private string? _signIn;

    /// <summary>What the pending sign-in is for: "upload" or "delete".</summary>
    private string _signInFor = "upload";

    protected override void OnInitialized() => Store.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Fills the upload form from the finished video's notes, once for each render, so what is typed over them is kept.</summary>
    private void Seed(MovieDto movie)
    {
        // A finished video just uploaded from here is the one a new render most likely replaces.
        var uploaded = movie.Publish.VideoLink is { } link && !link.Contains('\n') && !link.Contains("/shorts/", StringComparison.Ordinal) ? link : null;
        if (uploaded != _lastUploaded)
            (_lastUploaded, _replace) = (uploaded, uploaded ?? (_replace == _lastUploaded ? "" : _replace));
        var key = $"{movie.Id}|{movie.Publish.MasterUrl}";
        if (_seeded == key) return;
        (_seeded, _title, _description, _tags) = (key, movie.Publish.Title, movie.Publish.Description, movie.Publish.Tags);
    }

    /// <summary>
    /// Says what rendering will do (put the clips still to go through Meme-ify, at their cost, and use one of the day's
    /// runs), and renders once that is agreed to. With nothing to pay for and runs not counted, it just renders.
    /// </summary>
    private async Task RenderAsync()
    {
        if (Store.Movie is not { } movie) return;
        var memes = await Api.EstimateAsync(movie.Id, "memes/estimate");
        if (memes?.Refusal is { } refusal)
        {
            Store.Say(null, refusal);
            return;
        }
        var runs = await MovieDialogs.RunsLeftAsync(Runs);
        var paid = memes is { NothingToDo: false };
        if ((paid || runs.Length > 0)
            && !await MovieDialogs.ConfirmSpendAsync(Dialogs, Store, "Render the finished video?",
                (paid ? memes!.Summary : "Renders the movie, ready to download.") + runs, "Render", paid ? memes!.Dollars ?? 0 : 0))
            return;
        await Store.DoAsync($"render?preset={Store.Prefs.ExportPreset}", job: true);
    }

    /// <summary>Asks, then downloads the video; the server removes the movie once the download has finished.</summary>
    /// <summary>True from the press until the zip has been built and its download started, so one press is one package.</summary>
    private bool _packing;

    /// <summary>Why the last package could not be made, shown under the button; null when it went.</summary>
    private string? _packError;

    private async Task DownloadAsync()
    {
        if (_packing || Store.Movie is not { } movie) return;
        _packError = null;
        if (!await MovieDialogs.ConfirmAsync(Dialogs, "Download for YouTube and TikTok?",
                $"Packs one zip: {movie.Publish.MasterName} for YouTube, an upright copy for TikTok, a thumbnail, the text for both sites and a README. Making the upright copy takes a minute or two. When the download finishes, the movie and all its files are deleted from the server, so upload to YouTube from here first. To make it again you render it again.",
                "Download"))
            return;
        _packing = true;
        try
        {
            _packError = await Store.PackageAndDownloadAsync(movie.Id, ReleaseAsync);
        }
        finally
        {
            _packing = false;
        }
    }

    private async Task ReleaseAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("poMedia.releaseMedia", _masterVideo);
        }
        catch (JSException)
        {
            // Nothing playing.
        }
    }

    private async Task CopyAsync(string what, string text)
    {
        await JS.InvokeAsync<bool>("poMedia.copyText", text);
        Store.Say($"{what} copied. Paste it into YouTube's upload page.");
    }

    /// <summary>Asks, then opens Google's sign-in in a new tab; the upload starts when Google sends that tab back.</summary>
    private async Task UploadAsync()
    {
        if (_uploading || Store.Movie is not { } movie) return;
        var when = Store.Advanced && _publishAt is { } at ? new DateTimeOffset(at) : (DateTimeOffset?)null;
        var upload = new MovieUploadRequest(_title, _description, _tags, _privacy, when, false, NullIfBlank(_replace));
        var checkedUpload = UploadRules.Validate(upload);
        _errors = checkedUpload.IsValid ? null : checkedUpload.ToDictionary();
        if (!checkedUpload.IsValid) return;
        _uploading = true;
        try
        {
            await ConfirmAndUploadAsync(movie, upload, when);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task ConfirmAndUploadAsync(MovieDto movie, MovieUploadRequest upload, DateTimeOffset? when)
    {
        var seen = when is { } then ? $"private until {then:d MMM yyyy, HH:mm}, then public" : _privacy.ToLowerInvariant();
        var (title, message) = upload.Replace is { } old
                ? ("Replace the video on YouTube?", $"Uploads {movie.Publish.MasterName} to your channel as “{_title}”, {seen}{(movie.Publish.ThumbnailUrl is null ? "" : ", with the chosen thumbnail")}. Once it is up, {old} is deleted for good: its views, likes and comments go with it, and the new video has a new link. If the upload fails, the old video stays. A new tab opens to sign in to Google first, asking to upload and delete videos; that sign-in is used for this alone. It costs nothing.")
                : ("Upload to YouTube?", $"Uploads {movie.Publish.MasterName} to your channel as “{_title}”, {seen}{(movie.Publish.ThumbnailUrl is null ? "" : ", with the chosen thumbnail")}. A new tab opens to sign in to Google first; that sign-in is used for this upload only. It costs nothing.");
        if (!await MovieDialogs.ConfirmAsync(Dialogs, title, message, upload.Replace is null ? "Upload" : "Upload and replace")) return;
        _signInFor = "upload";
        await SignInAsync(movie, upload, "Next, sign in to Google: the button is in the YouTube section.");
    }

    /// <summary>Asks, then opens Google's sign-in; the video is deleted when Google sends that tab back.</summary>
    private async Task DeleteFromYouTubeAsync()
    {
        if (_uploading || Store.Movie is not { } movie || YouTubeLinks.VideoId(_replace) is not { } id) return;
        _uploading = true;
        try
        {
            if (!await MovieDialogs.ConfirmAsync(Dialogs, "Delete this video from YouTube?",
                    $"{YouTubeLinks.Watch(id)} is deleted from your channel for good, with its views, likes and comments. YouTube keeps no copy to bring back. A new tab opens to sign in to Google first, asking to upload and delete videos; that sign-in is used for this alone.",
                    "Delete it"))
                return;
            _signInFor = "delete";
            await SignInAsync(movie, new MovieUploadRequest("", "", "", _privacy, null, false, _replace.Trim(), DeleteOnly: true),
                "Next, sign in to Google: the button is in the YouTube section.");
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string? NullIfBlank(string text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();

    private async Task SignInAsync(MovieDto movie, MovieUploadRequest upload, string next)
    {
        var reply = await Api.UploadAsync(movie.Id, upload);
        if (reply.Url is null)
        {
            Store.Say(null, reply.Error);
            return;
        }
        // A link the user presses themselves: a tab opened from here, after the question, is one browsers block.
        _signIn = reply.Url;
        Store.Say(next);
        _ = WaitForUploadAsync();
    }

    // The upload begins on the server when Google sends the other tab back: watch for it for a few minutes.
    private async Task WaitForUploadAsync()
    {
        for (var i = 0; i < 150 && !Store.IsWorking; i++)
        {
            await Task.Delay(2000);
            if (await Api.JobAsync() is { State: "running" })
            {
                _signIn = null;
                await Store.FollowJobAsync();
                return;
            }
        }
        _signIn = null;
    }

    private ElementReference _masterVideo;

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnChanged;
        try
        {
            await JS.InvokeVoidAsync("poMedia.releaseMedia", _masterVideo);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException)
        {
            // Element was never rendered or circuit already tore down.
        }
    }
}
