@* The films: upload the videos and make the whole movie from them in
   one go. Each film's narration and note fold away under its options button. Saved movies are on
   the right, to open again. *@
@implements IDisposable
@inject MovieStore Store
@inject FluentValidation.IValidator<MovieLessonRequest> LessonRules
@inject MovieApi Api
@inject DialogService Dialogs
@inject IJSRuntime JS
@inject RunApi Runs

@if (Store.Config is { } config)
{
<div class="mv-two">
    <div class="mv-side mv-form">
        <h2 class="mv-section">@(Store.Movie is null ? "Your films" : "Make another movie")</h2>
        <div class="mv-field">
            <RadzenLabel Text="Kind of video" Component="mv-kind" />
            <RadzenSelectBar Name="mv-kind" class="mv-kind" TValue="string" Value="@(Store.Auto ? "Auto" : Store.Show)" Change="@(kind => PickKindAsync(kind))" Disabled="Store.IsWorking" Size="ButtonSize.Small"
                             title="Auto: the films are watched and the app decides what kind of video they make (kids, pets, a trip, a party, sport, a how-to…), and from that the series, pace, music, narrator and roast. General: a movie about anything. Robot lesson: an episode of the R1 series. Kids' video: your child playing, told for young children and uploaded as made for kids. Each has its own intro, outro and look, under Channel & intro. Switching costs nothing.">
                <Items>
                    <RadzenSelectBarItem Text="Auto" Value="@("Auto")" />
                    @foreach (var show in config.Shows)
                    {
                        <RadzenSelectBarItem Text="@show.Label" Value="@show.Value" />
                    }
                </Items>
            </RadzenSelectBar>
        </div>
        <div class="mv-row mv-top">
            <div class="mv-field mv-grow">
                <RadzenLabel Text="Title" Component="mv-new-title" />
                <RadzenTextBox Name="mv-new-title" @bind-Value="Store.Title" MaxLength="120" Placeholder="Leave empty to let the AI name it" class="mv-wide"
                               title="The movie's title, shown in the intro and used for the upload. Leave it empty and one is written from your films." />
                <FieldErrors Errors="_errors" For="Title" />
            </div>
            <div class="mv-field">
                <RadzenLabel Text="Episode" Component="mv-new-number" />
                <RadzenNumeric Name="mv-new-number" TValue="int" Value="@Store.Number" Min="1" Max="999" class="mv-narrow" Change="@(n => { Store.Number = n; Store.Notify(); })"
                               title="The episode number the intro shows (#3 · its title). The next in the series is filled in; type your own to redo or skip one." />
                <FieldErrors Errors="_errors" For="Number" />
            </div>
        </div>

        @* The one thing a movie cannot be made without, so it says so and its upload is open until there is a clip. *@
        <div class="mv-row mv-between" id="mv-clips">
            <span class="mv-row">
                <strong>Your video clips</strong>
                @if (Store.FilmList.Count == 0)
                {
                    <span class="mv-required">Required</span>
                }
                else
                {
                    <RadzenIcon Icon="check_circle" class="mv-ok" aria-label="Done" />
                }
            </span>
            <span class="mv-row">
            @if (Store.FilmList.Count > 1)
            {
                <RadzenButton Text="Remove all" Icon="clear_all" Variant="Variant.Text" Size="ButtonSize.Small" Disabled="Store.IsWorking" Click="@(() => { Store.FilmList.Clear(); Store.Notify(); })"
                              title="Take every clip off this list. They stay in your Library; upload them again with Add more clips." />
            }
            @if (Store.FilmList.Count > 0)
            {
                <RadzenButton Text="@(_adding ? "Done" : "Add more clips")" Icon="@(_adding ? "check" : "add")" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => _adding = !_adding)"
                              title="Upload more videos (2 seconds to 1 minute each)." />
            }
            </span>
        </div>
        @if (Store.FilmList.Count == 0 || _adding)
        {
            <div class="mv-add-films @(Store.FilmList.Count == 0 ? "mv-needed" : null)">
                @if (Store.FilmList.Count == 0)
                {
                    <p class="mv-add-lead">A movie is made from your own videos. Upload at least one clip (up to a minute each) to continue.</p>
                }
                @* While a choice of several files uploads, the zone stays (it would close at the first clip and take the rest
                   of the files with it); it closes once they are all in. *@
                <MediaPicker ValueChanged="AddFilm" Multiple="true" Camera="false" Accept=".mp4,.mov,.webm" BatchStarted="@(() => _adding = true)"
                             BatchDone="@(() => { _adding = false; Store.Notify(); })" />
            </div>
        }
        @if (Store.FilmList.Count > 0)
        {
            var total = TimeSpan.FromTicks(Store.FilmList.Sum(f => f.Length.Ticks));
            <span class="@(total > MaxMovie ? "mv-caution" : "mv-quiet")" title="Your films end to end. A movie can be up to 10 minutes, and each film up to a minute.">
                @($"{(Store.FilmList.Count == 1 ? "1 film" : $"{Store.FilmList.Count} films")} · {total:m\\:ss} of 10:00")@(total > MaxMovie ? ": too long for one movie. Leave some out." : "")
            </span>
        }
        <FieldErrors Errors="_errors" For="Films" />
        <div class="mv-row mv-top">
            <div class="mv-field">
                <RadzenLabel Text="Use" Component="mv-cut" />
                <RadzenSelectBar Name="mv-cut" TValue="string" Value="@Store.Cut" Change="@(cut => { Store.Cut = cut; Store.Notify(); })" Disabled="Store.IsWorking" Size="ButtonSize.Small"
                                 title="Best parts: each film is watched and only its good stretches are kept (several from one film if it has them), without dead air, fumbling or repeats, at a shot length that suits the kind of video. Whole films: every film plays from start to end.">
                    <Items>
                        <RadzenSelectBarItem Text="Best parts" Value="@MovieLessonRequest.BestParts" />
                        <RadzenSelectBarItem Text="Whole films" Value="@MovieLessonRequest.WholeFilms" />
                    </Items>
                </RadzenSelectBar>
                <FieldErrors Errors="_errors" For="Cut" />
            </div>
            <div class="mv-field">
                <RadzenLabel Text="Format" Component="mv-format" />
                <RadzenSelectBar Name="mv-format" TValue="string" Value="@Store.Format" Change="@(format => { Store.Format = format; Store.Notify(); })" Disabled="Store.IsWorking" Size="ButtonSize.Small"
                                 title="Full video: wide (16:9), as long as the films need. Short: upright (9:16) and under a minute, keeping the best parts that fit. Auto: a Short when most films are upright and their best parts fit one, otherwise a full video.">
                    <Items>
                        <RadzenSelectBarItem Text="Auto" Value="@MovieLessonRequest.AutoFormat" />
                        <RadzenSelectBarItem Text="Full video" Value="@MovieLessonRequest.FullFormat" />
                        <RadzenSelectBarItem Text="Short" Value="@MovieLessonRequest.ShortFormat" />
                    </Items>
                </RadzenSelectBar>
                <FieldErrors Errors="_errors" For="Format" />
            </div>
        </div>
        @foreach (var film in Store.FilmList)
        {
            var row = film;
            var open = _options.Contains(row.Media.Id);
            var tooShort = row.Media.DurationSeconds is < 5;
            <div class="mv-film">
                <img src="@row.Media.ThumbUrl" alt="" loading="lazy" />
                <div class="mv-film-body">
                    <div class="mv-row mv-between">
                        <span class="mv-film-name" title="@row.Media.Title"><strong>@row.Media.Title</strong> <span class="mv-quiet">@Length(row.Media.DurationSeconds)</span></span>
                        <span class="mv-row">
                            <RadzenButton Icon="tune" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => { if (!_options.Remove(row.Media.Id)) _options.Add(row.Media.Id); })"
                                          title="Options for this film: narration, and a note on what it shows." aria-label="Options for this film" aria-expanded="@(open ? "true" : "false")" />
                            <RadzenButton Icon="close" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => { Store.FilmList.Remove(row); Store.Notify(); })"
                                          title="Leave this film out of the movie. It stays in your Library; upload it again with Add more clips." aria-label="Leave this film out" />
                        </span>
                    </div>
                    <span class="mv-quiet">@(tooShort ? "Too short to narrate: plays its own sound" : row.OwnSound ? "Its own sound, no narrator" : "Narrated")@(config.Memes ? " · memes" : "")</span>
                    @if (row.Listening is { } listening)
                    {
                        <span class="mv-quiet" aria-live="polite" title="This server has no speech model, so the speech model in your browser listens to the film, for its captions. Free.">@listening</span>
                    }
                    @if (open)
                    {
                        <div class="mv-row">
                            <RadzenSwitch Value="!row.OwnSound" Disabled="tooShort" Name="@($"mv-own-{row.Media.Id}")" Change="@(on => { row.OwnSound = !on; _ = HearAsync(row); })" />
                            <RadzenLabel Text="AI narration" Component="@($"mv-own-{row.Media.Id}")"
                                         title="On (as every film starts): an AI narrator speaks over the film, fitted to its length, with the film's own sound turned down underneath. Off: the film plays with its own sound alone." />
                        </div>
                        <div class="mv-row">
                            <RadzenTextBox @bind-Value="row.Note" MaxLength="200" Placeholder="What it shows (optional): first try, falls over" class="mv-grow" aria-label="What this film shows"
                                           title="A few words on what this film shows, for the narrator. Leave it empty and the film is watched for you." />
                            <RadzenButton Icon="visibility" Variant="Variant.Text" Size="ButtonSize.Small" IsBusy="row.Watching" Disabled="@(!config.Script)" Click="@(() => WatchAsync(row))"
                                          title="Suggest a note: a model watches a few frames of the film and says what it shows. A cent or two, once per film." aria-label="Suggest a note" />
                        </div>
                    }
                </div>
            </div>
        }

        @if (config.Memes && Store.Auto)
        {
            <p class="mv-quiet mv-auto-note">Auto picks the narrator, the roast and the music once it has watched your films. Pick a kind of video above to choose them yourself.</p>
        }
        else if (config.Memes)
        {
            <MovieRoastOptions Voices="config.RoastVoices" Voice="@Store.RoastVoice" VoiceChanged="@(v => { Store.RoastVoice = v; Store.Notify(); })"
                               Mix="@Store.Mix" MixChanged="@(mix => { Store.Mix = mix; Store.CrudeRoast = mix.Crude; Store.Notify(); })" Defaults="@MemeMix.For(Store.Show)"
                               Narrator="@Store.Narrator" NarratorChanged="@(n => { Store.Narrator = n; Store.Notify(); })" Disabled="Store.IsWorking" IdPrefix="mv-films-roast" />
        }

        <div class="mv-pinned">
            @if (Store.FilmList.Count == 0)
            {
                <a class="mv-need-clips" href="movie#mv-clips">
                    <RadzenIcon Icon="arrow_upward" aria-hidden="true" />Add at least one video clip under Your video clips to continue.
                </a>
            }
            <RadzenButton Text="Just make it" Icon="auto_awesome" ButtonStyle="ButtonStyle.Primary"
                          Disabled="@(_making || Store.IsWorking || !config.Ffmpeg || Store.FilmList.Count == 0)" IsBusy="_making" Click="JustMakeAsync" class="mv-wide"
                          title="No settings: the films are watched and listened to, the app decides what kind of video they make, keeps their best parts, puts them in order, picks the narrator, roast and music, cuts on the beat, and looks the clips over before the final render. You are told what it costs first." />
            <RadzenButton Text="Make the video from my films" Icon="movie" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined"
                          Disabled="@(_making || Store.IsWorking || !config.Ffmpeg || Store.FilmList.Count == 0 || TimeSpan.FromTicks(Store.FilmList.Sum(f => f.Length.Ticks)) > MaxMovie)" IsBusy="_making" Click="MakeAsync" class="mv-wide"
                          title="Make the whole video from the films above in one go: each film is watched, given a voice-over that fits its length, put through Meme-ify, and the films are joined between the series' intro and outro, rendered and put in your Library. You are told what it does and costs first." />
        </div>
    </div>

    <div class="mv-main">
        @if (Store.Library.Count > 0)
        {
            <div class="mv-row mv-between">
                <h2 class="mv-section">Saved movies</h2>
                <RadzenButton Text="Delete all" Icon="delete_sweep" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" Disabled="Store.IsWorking" Click="DeleteAllAsync"
                              title="Delete every saved movie, with its script, voices, pictures and finished videos. Videos already in your Library stay there." />
            </div>
            <div class="mv-library">
                @foreach (var saved in Store.Library)
                {
                    var item = saved;
                    <div class="mv-saved @(item.Id == Store.Movie?.Id ? "open" : null)">
                        <RadzenButton ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" class="po-plain mv-saved-open" Click="@(() => OpenAsync(item))" title="@($"{item.Title}\nSaved {item.Saved.ToLocalTime():d MMM yyyy, HH:mm}. Click to open this movie and carry on with it.")">
                            @if (item.ThumbUrl is not null)
                            {
                                <img src="@item.ThumbUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="mv-saved-blank" aria-hidden="true"><RadzenIcon Icon="movie" /></span>
                            }
                            <span class="mv-saved-text"><strong>@item.Title</strong><span class="mv-quiet">@item.Details</span></span>
                        </RadzenButton>
                        <RadzenSplitButton Icon="more_horiz" Variant="Variant.Text" Size="ButtonSize.Small" AlwaysOpenPopup="true" Click="@(choice => SavedAsync(item, choice))" aria-label="@($"More for {item.Title}")">
                            <ChildContent>
                                <RadzenSplitButtonItem Text="Make a copy" Value="copy" Icon="content_copy" />
                                <RadzenSplitButtonItem Text="Delete…" Value="delete" Icon="delete" />
                            </ChildContent>
                        </RadzenSplitButton>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="mv-empty">
                <RadzenIcon Icon="movie_filter" aria-hidden="true" />
                <strong>No movies yet.</strong>
                <span>First upload at least one video clip under <em>Your video clips</em>, then press <em>Make the video from my films</em>. Movies you make are kept here to open again.</span>
            </div>
        }
    </div>
</div>
}

@code {
    private static readonly TimeSpan MaxMovie = TimeSpan.FromMinutes(10);
    private bool _adding;
    private readonly HashSet<Guid> _options = [];

    protected override void OnInitialized() => Store.Changed += OnChanged;

    private void OnChanged()
    {
        // Once a message is showing, it follows the fields: fixing one takes it away.
        if (_errors is not null && Store.Config is not null) Check();
        InvokeAsync(StateHasChanged);
    }

    private static string Length(double? seconds) => seconds is { } s ? TimeSpan.FromSeconds(s).ToString(@"m\:ss") : "";

    private void AddFilm(MediaDto media)
    {
        if (media.Kind != MediaKind.Video)
        {
            Store.Say(null, "That is a picture. A movie's films are videos: choose an MP4, MOV or WEBM.");
            return;
        }
        if (Store.FilmList.Any(f => f.Media.Id == media.Id))
        {
            Store.Tell("That film is already in the list.");
            return;
        }
        if (Store.FilmList.Count >= (Store.Config?.MaxFilms ?? 20))
        {
            Store.Say(null, $"A movie can be made from up to {Store.Config?.MaxFilms ?? 20} films.");
            return;
        }
        if (media.DurationSeconds > 62)
        {
            Store.Say(null, "Each film can be up to a minute long. Trim it, then add it again.");
            return;
        }
        var film = new MovieFilm(media);
        Store.FilmList.Add(film);
        Store.Notify();
        _ = HearAsync(film);
    }

    /// <summary>
    /// For a server with no speech model: the speech model in this browser listens to a film that keeps its own sound,
    /// so what is said in it becomes its captions and Meme-ify can time its jokes by it. Once for each film; free.
    /// </summary>
    private async Task HearAsync(MovieFilm film)
    {
        if (Store.Config?.ServerSpeech != false || !film.OwnSound || film.Heard || film.Listening is not null) return;
        if (await Api.HeardAsync(film.Media.Id))
        {
            film.Heard = true;
            return;
        }
        film.Listening = "Listening on your device…";
        Store.Notify();
        using var progress = DotNetObjectReference.Create(new BlobUploadService.ProgressSink(percent =>
        {
            film.Listening = percent >= 0 ? $"Getting the speech model ready: {percent}%" : "Listening on your device…";
            Store.Notify();
        }));
        var lines = await JS.InvokeAsync<int>("poDeviceAi.transcribeMedia", film.Media.Url, film.Media.Id, progress);
        (film.Listening, film.Heard) = (null, lines >= 0);
        if (lines < 0)
            Store.Warn($"What is said in “{film.Media.Title}” could not be heard on this device, so its captions are yours to type.");
        Store.Notify();
    }

    private async Task WatchAsync(MovieFilm film)
    {
        film.Watching = true;
        var seen = await Api.WatchFilmAsync(Store.Show, new MovieFilmDto(film.Media.Id, film.Note, film.OwnSound));
        film.Watching = false;
        if (seen.Note is { Length: > 0 } note) film.Note = note.Length > 200 ? note[..200] : note;
        Store.Say(seen.Timeline is null ? null : $"Seen in “{film.Media.Title}”: {seen.Timeline}", seen.Error);
    }

    /// <summary>The form's messages from the last check (MovieLessonRequestValidator, which POST /api/movies/make runs too), or null.</summary>
    private IDictionary<string, string[]>? _errors;

    /// <summary>True from the press until the job has started (or was not), so one press makes one movie.</summary>
    private bool _making;

    /// <summary>Checks the form as it would be sent; true when it may go.</summary>
    private bool Check()
    {
        var config = Store.Config!;
        var result = LessonRules.Validate(Store.LessonRequest(), new MovieLimits(config.MaxFilms, config.MaxTopicLength));
        _errors = result.IsValid ? null : result.ToDictionary();
        return result.IsValid;
    }

    private async Task MakeAsync()
    {
        if (_making || !Check()) return;
        _making = true;
        try
        {
            await ConfirmAndMakeAsync();
        }
        finally
        {
            _making = false;
        }
    }

    private async Task ConfirmAndMakeAsync()
    {
        var n = Store.FilmList.Count;
        var config = Store.Config!;
        var roastOff = string.Equals(Store.RoastVoice, "Off", StringComparison.OrdinalIgnoreCase) || config.RoastVoices is not { Length: > 0 };
        var roastDesc = roastOff ? "(roast off)"
            : $"and a {(Store.CrudeRoast ? "crude " : "")}{(string.Equals(Store.RoastVoice, "Rap", StringComparison.OrdinalIgnoreCase) ? "rap roast" : "spoken roast")}";
        var memes = !config.Memes ? "" : $" Each clip then goes through Meme-ify for meme sounds, stickers, text and effects {roastDesc}, about {MovieDialogs.Money(n * config.MemePrice)}.";
        var named = string.IsNullOrWhiteSpace(Store.Title) ? "a title the AI picks" : $"“{Store.Title.Trim()}”";
        var plan = $"Makes episode #{Store.Number}, {named}. Watches your {(n == 1 ? "film" : $"{n} films")}, writes a voice-over for each that fits its length and records it over the film's own sound.{memes} Then it joins them between the series' intro and outro, renders the finished video and puts it in your Library. No pictures are drawn. You can stop it at any point, and render it again with other meme settings afterwards."
            + await MovieDialogs.RunsLeftAsync(Runs);
        if (await MovieDialogs.ConfirmSpendAsync(Dialogs, Store, "Make the video from your films?", plan, "Make it", config.Memes ? n * config.MemePrice : 0))
            await Store.StartMovieAsync(true);
    }

    private async Task PickKindAsync(string kind)
    {
        Store.Auto = kind == "Auto";
        if (Store.Auto) Store.Notify();
        else await Store.SetShowAsync(kind);
    }

    /// <summary>"Just make it": no settings are asked for; the cost is still said first.</summary>
    private async Task JustMakeAsync()
    {
        if (_making) return;
        _making = true;
        try
        {
            var n = Store.FilmList.Count;
            var config = Store.Config!;
            // Best parts can make more clips than there are films: each is meme-ified, so the price is a range.
            var most = Math.Min(config.MaxFilms, Math.Max(n, n * 3));
            var memes = !config.Memes ? "" : $" Each kept moment goes through Meme-ify, about {MovieDialogs.Money(config.MemePrice)} each: {MovieDialogs.Money(n * config.MemePrice)} to {MovieDialogs.Money(most * config.MemePrice)} for {(n == 1 ? "this film" : $"these {n} films")}.";
            var plan = $"Watches and listens to your {(n == 1 ? "film" : $"{n} films")}, decides what kind of video they make, keeps the best parts and puts them in order, chooses the narrator, roast and music, narrates the quiet parts and lets people who talk be heard, cuts on the beat, and looks the clips over before the final render.{memes} Episode #{Store.Number}. You can stop it at any point."
                + await MovieDialogs.RunsLeftAsync(Runs);
            if (await MovieDialogs.ConfirmSpendAsync(Dialogs, Store, "Just make it?", plan, "Make it", config.Memes ? n * config.MemePrice : 0))
                await Store.StartMovieAsync(true, Store.JustMakeRequest());
        }
        finally
        {
            _making = false;
        }
    }

    private async Task OpenAsync(MovieSummaryDto item)
    {
        if (Store.IsWorking)
        {
            Store.Say(null, "Wait for the job in progress to finish, or cancel it, before opening another movie.");
            return;
        }
        if (!item.Damaged)
        {
            await Store.OpenAsync(item.Id);
            return;
        }
        if (await MovieDialogs.ConfirmAsync(Dialogs, "This movie's file is damaged", "Restore it from the copy saved just before the last change?", "Restore")
            && Store.Apply(await Api.DoAsync(item.Id, "restore")))
            await Store.OpenAsync(item.Id);
    }

    private async Task SavedAsync(MovieSummaryDto item, RadzenSplitButtonItem? choice)
    {
        switch (choice?.Value)
        {
            case "copy":
                Store.Say($"Copying {item.Title}…");
                var reply = await Api.DoAsync(item.Id, "duplicate");
                await Store.RefreshLibraryAsync();
                Store.Say(reply.Error is null ? $"Copied {item.Title}." : null, reply.Error);
                break;
            case "delete":
                if (await MovieDialogs.ConfirmAsync(Dialogs, $"Delete {item.Title}?", "The movie's folder, with its script, voices, pictures and finished videos, is deleted for good.", "Delete"))
                    await Store.DeleteAsync(item);
                break;
        }
    }

    private async Task DeleteAllAsync()
    {
        var n = Store.Library.Count;
        if (await MovieDialogs.ConfirmAsync(Dialogs, n == 1 ? "Delete your 1 saved movie?" : $"Delete all {n} saved movies?",
                "Every movie's folder, with its script, voices, pictures and finished videos, is deleted for good. Videos already in your Library stay there.", "Delete all"))
            await Store.DeleteAllAsync();
    }

    public void Dispose() => Store.Changed -= OnChanged;
}
