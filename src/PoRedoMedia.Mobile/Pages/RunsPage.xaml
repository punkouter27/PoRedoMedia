<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoRedoMedia.Mobile.Pages.RunsPage"
             Title="Runs">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Render Runs &amp; Quota" FontSize="22" FontAttributes="Bold" />
            <Button Text="Refresh" Clicked="OnRefreshClicked" />
            <Label x:Name="QuotaLabel" FontSize="13" />
            <VerticalStackLayout x:Name="RunsList" Spacing="8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
